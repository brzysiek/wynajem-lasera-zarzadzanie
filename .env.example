DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Managed automatically by deploy/deploy-pull.sh on every deploy (kept in
# sync with the workflow's BASE_PATH) — do not need to set manually except
# for local dev, where it can stay unset (falls back to /wynajem, see
# next.config.ts / src/lib/base-path.ts).
NEXT_PUBLIC_BASE_PATH=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
GOOGLE_WEBHOOK_BASE_URL=

HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

SMSAPI_TOKEN=
SMSAPI_SENDER_NAME=

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

CRON_SECRET=
REMINDER_SEND_HOUR=10
TZ=Europe/Warsaw

# Verbosity of app-*.log/app-error-*.log (DEBUG < INFO < WARN < ERROR). Default: INFO.
LOG_LEVEL=INFO
# How many days of rotated log files to keep before automatic cleanup. Default: 30.
LOG_RETENTION_DAYS=30
