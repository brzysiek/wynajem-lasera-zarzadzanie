generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum Channel {
  SMS
  EMAIL
}

enum ReminderStatus {
  SCHEDULED
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum MessageStatus {
  SENT
  FAILED
}

enum SyncDirection {
  PULL
  PUSH
}

enum SyncStatus {
  OK
  ERROR
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STAFF)
  invitedAt    DateTime?
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())

  messages            Message[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Device {
  id               String   @id @default(uuid())
  name             String
  shortName        String
  color            String
  googleCalendarId String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  rentals  Rental[]
  syncLogs SyncLog[]

  @@map("devices")
}

model Rental {
  id                  String    @id @default(uuid())
  deviceId            String
  googleEventId       String
  googleCalendarId    String
  title               String
  description         String?   @db.Text
  startsAt            DateTime
  endsAt              DateTime
  allDay              Boolean   @default(false)
  hubspotContactId    String?
  contactNameCache    String?
  contactPhoneCache   String?
  contactEmailCache   String?
  contactCompanyCache String?
  contactAddressCache String?   @db.Text
  internalNotes       String?   @db.Text
  lastSyncedAt        DateTime?
  deletedInGoogle     Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  device        Device         @relation(fields: [deviceId], references: [id])
  reminderRules ReminderRule[]
  messages      Message[]

  @@unique([googleCalendarId, googleEventId])
  @@map("rentals")
}

model ReminderRule {
  id           String         @id @default(uuid())
  rentalId     String
  daysBefore   Int
  channel      Channel
  messageBody  String         @db.Text
  status       ReminderStatus @default(SCHEDULED)
  scheduledFor DateTime
  sentAt       DateTime?
  errorMessage String?        @db.Text
  edited       Boolean        @default(false)

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("reminder_rules")
}

model Message {
  id                String        @id @default(uuid())
  rentalId          String?
  userId            String?
  channel           Channel
  recipient         String
  subject           String?       @db.Text
  body              String        @db.Text
  status            MessageStatus
  providerMessageId String?
  errorMessage      String?       @db.Text
  sentAt            DateTime      @default(now())

  rental Rental? @relation(fields: [rentalId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@map("messages")
}

model MessageTemplate {
  id      String  @id @default(uuid())
  key     String  @unique
  label   String
  channel Channel
  subject String? @db.Text
  body    String  @db.Text

  @@map("message_templates")
}

model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

model SyncLog {
  id              String        @id @default(uuid())
  deviceId        String?
  direction       SyncDirection
  eventsProcessed Int
  status          SyncStatus
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())

  device Device? @relation(fields: [deviceId], references: [id])

  @@map("sync_logs")
}

enum ReminderCheckSource {
  CRON
  MANUAL
}

model ReminderCheckLog {
  id             String              @id @default(uuid())
  rentalsChecked Int
  dueCount       Int
  sentCount      Int
  failedCount    Int
  queuedCount    Int                 @default(0)
  source         ReminderCheckSource @default(CRON)
  createdAt      DateTime            @default(now())

  @@map("reminder_check_logs")
}
