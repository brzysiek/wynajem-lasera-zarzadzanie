generator client {
  provider = "prisma-client-js"
  // The client is generated in CI (Ubuntu) and rsynced to the cyberfolks
  // boxes — `prisma generate` can't run there under the LVE thread cap.
  // "native" covers CI's own `next build`. The two cyberfolks boxes turned
  // out to run different distros/OpenSSL versions than assumed: server 2
  // (wynajemlasera.pl) needs debian-openssl-1.1.x specifically (confirmed
  // via a live PrismaClientInitializationError in its stderr.log — CI's
  // "native" build only ships debian-openssl-3.0.x), and rhel-* is kept for
  // server 1 in case it really is CloudLinux/RHEL. (The app talks to the DB
  // via @prisma/adapter-mariadb so the native engine is normally unused, but
  // the client still probes for a matching binary at init.)
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  KIEROWCA
  // Agent AI („Klaudiusz”) — asystent biura: czyta, porządkuje dane klientów,
  // przygotowuje zadania. Bez kontaktu z klientami, bez rezerwacji, bez
  // usuwania. Uprawnienia: src/lib/permissions.ts (egzekwowane w API).
  AGENT
}

enum Channel {
  SMS
  EMAIL
}

enum ReminderStatus {
  SCHEDULED
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum MessageStatus {
  SENT
  FAILED
}

enum SyncDirection {
  PULL
  PUSH
}

enum SyncStatus {
  OK
  ERROR
}

// --- Moduł finansowy wydarzeń (patrz docs/finanse-wynajmu/) ---

enum DevicePricingCategory {
  LIGHTSHEER_VARIANT // DESIRE, LIGHT, QUATTRO — wspólna tabela cen wariantów głowicy
  LIGHTSHEER_ET400_FLAT // ET400 — cena stała, bez wariantów, bez impulsów
  ALMA_HARMONY // Alma Harmony XL Pro — wariant głowicy + zawsze dopłata za impulsy
  COOLTECH_FLAT
  RESURFX_FLAT
  OBSERV_FLAT
}

enum RentalEventType {
  WYNAJEM
  SZKOLENIE
}

enum PriceSource {
  PRICE_LIST // z tabeli PriceRule
  MANUAL // wpisana ręcznie (nadpisanie albo brak reguły)
  PULSE_CALCULATED // wyliczona z licznika impulsów (LightSheer wariant elastyczny)
  CLIENT_TERMS // z warunków handlowych klienta (ClientPrice) — karta klienta, etap C
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PulseCalculationStatus {
  PENDING // liczniki nieodczytane — kwota tymczasowa
  CALCULATED // liczniki wpisane, kwota faktycznie wyliczona
}

enum GrammaticalGender {
  M
  F
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STAFF)
  // ADMIN/STAFF z tą flagą mogą przełączyć aplikację w „podgląd kierowcy"
  // (rola efektywna, bez zmiany roli w bazie) — patrz src/lib/effective-role.ts.
  canActAsDriver Boolean @default(false)
  // Agent AI (rola AGENT) może przydzielać tej osobie zadania — ustawia
  // ADMIN w Ustawienia → Użytkownicy. Domyślnie nie.
  agentAssignable Boolean @default(false)
  // Płeć gramatyczna — do odmiany „zlecił"/„zleciła" w liście zadań.
  grammaticalGender GrammaticalGender?
  // Przewodniki po panelu (wniosek 19): { "signalsV2": { "done": true, "later": 1 } }
  // — obejrzany / „Później” (maks. 3 razy); osobno dla każdego użytkownika.
  tourSeen Json?
  // Stawka za godzinę pracy — TYLKO rola KIEROWCA, null dla innych. REGUŁA
  // BEZPIECZEŃSTWA (docs/prompt-claude-code-dashboard-kosztow.md, sekcja 1.4):
  // to pole i wszystko z niego wyliczone (koszt pracy kierowcy) nie może się
  // pojawić w ŻADNEJ odpowiedzi API dostępnej roli KIEROWCA — nawet dla
  // właściciela tej stawki. Sprawdzaj to przy każdym endpointzie zwracanym
  // tej roli, nie tylko ukrywaj w UI.
  hourlyRate   Decimal?  @db.Decimal(8, 2)
  // Kolor ikony kierownicy na kafelkach kalendarza (rola KIEROWCA) — żeby
  // dało się odróżnić przypisanego kierowcę na pierwszy rzut oka, bez
  // najeżdżania kursorem na tooltip (zgłoszone przez użytkownika). Hex
  // string jak Device.color; null = brak przypisanego koloru (neutralny
  // wygląd ikony, jak dotychczas).
  driverColor  String?
  invitedAt    DateTime?
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())

  messages            Message[]
  passwordResetTokens PasswordResetToken[]
  assignedRentals     Rental[]             @relation("RentalDriver")
  authoredTasks       Task[]               @relation("TaskAuthor")
  assignedTasks       Task[]               @relation("TaskAssignee")
  ownedLeads          Lead[]               @relation("LeadOwner")
  leadActivities      LeadActivity[]
  changeLogs          ChangeLog[]          @relation("ChangeLogUser")
  taskComments        TaskComment[]
  proposals           Proposal[]           @relation("ProposalAuthor")
  proposalComments    ProposalComment[]
  proposalStatuses    ProposalStatusChange[]
  remarks             Remark[]
  cleanupRules        CleanupRule[]
  apiTokens           ApiToken[]           @relation("ApiTokenUser")
  deliveryFeedback    DeliveryFeedback[]   @relation("DeliveryFeedbackDriver")

  @@map("users")
}

enum TaskStatus {
  OPEN
  DONE
}

// Lista zadań zespołu — widoczna tylko w widoku admina (panel wysuwany).
// Każde zadanie ma autora (kto utworzył) i odpowiedzialnego (kto ma zrobić).
model Task {
  id          String     @id @default(uuid())
  title       String
  notes       String?    @db.Text
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  dueDate     DateTime?
  authorId    String?
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User? @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Zadanie przy sygnale / kliencie (CRM, prompt 2) — link w panelu Zadań.
  leadId   String?
  clientId String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  comments TaskComment[]
  // Wniosek 22: powiązania zadania (wiele wynajmów, klientów, sygnałów,
  // faktur). clientId / leadId zostają dla zgodności i też są powiązaniami.
  links       TaskLink[]

  @@index([status])
  @@index([authorId])
  @@index([assigneeId])
  @@index([leadId])
  @@index([clientId])
  @@map("tasks")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Device {
  id               String   @id @default(uuid())
  name             String
  shortName        String
  color            String
  googleCalendarId String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  // Konfiguracja cennika — uzupełniana ręcznie przez ADMINA na /urzadzenia po
  // wdrożeniu (migracja świadomie nie zgaduje tego z nazwy urządzenia).
  pricingCategory DevicePricingCategory?
  // Dozwolone warianty głowicy dla tego egzemplarza, np. ["single_standard","single_flex","double"]
  // (LightSheer) lub ["dye_vl","dye_vl_ipixel"] (Alma). null / [] dla kategorii *_FLAT.
  variantOptions  Json?

  rentals  Rental[]
  syncLogs SyncLog[]
  costs    Cost[]
  history  RentalHistory[]

  @@map("devices")
}

model Rental {
  id                  String    @id @default(uuid())
  deviceId            String
  googleEventId       String
  googleCalendarId    String
  title               String
  description         String?   @db.Text
  startsAt            DateTime
  endsAt              DateTime
  allDay              Boolean   @default(false)
  hubspotContactId    String?
  contactNameCache    String?
  contactPhoneCache   String?
  contactEmailCache   String?
  contactCompanyCache String?
  contactAddressCache String?   @db.Text
  // raw "ustalona_cena_transportu" from the HubSpot contact, refreshed on assign
  contactTransportPriceCache String?
  // NIP kontrahenta z HubSpot, refreshed on assign — podstawa wyszukania
  // kontrahenta w Fakturowni przy wystawianiu faktury (RentalFinance.invoiceError itd.)
  contactNipCache String?
  deliveryAddress     String?   @db.Text
  deliveryTime        String?
  pickupTime          String?
  // editable per-rental; prefilled from contactTransportPriceCache when empty
  transportPrice      String?
  internalNotes       String?   @db.Text
  driverId            String?
  vehicleId           String?
  // Odległość do klienta (km) — wpisywana ręcznie przez biuro, raz przy danym
  // kliencie (ten sam wzorzec co contactTransportPriceCache). Podstawa
  // wyliczenia kosztu paliwa per wynajem (docs/prompt-claude-code-dashboard-kosztow.md, sekcja 3.1).
  contactDistanceKm   Decimal?  @db.Decimal(6, 1)
  eventType           RentalEventType @default(WYNAJEM)
  // Uwagi kierowcy: dawniej jedno pole na cały wynajem, teraz osobno per etap
  // — RentalFinance.deliveryNotes / pickupNotes (dostawa i odbiór mogą mieć
  // zupełnie inny kontekst, np. "dostawa połączona z innym klientem").
  lastSyncedAt        DateTime?
  deletedInGoogle     Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Klient z bazy panelu (CRM, etap 1). Na razie tylko DODANE obok
  // hubspotContactId i contact*Cache — te pola dalej zasilają przychody,
  // faktury, przypomnienia i alerty; zmienia się jedynie ich źródło w
  // późniejszym kroku. SetNull: usunięcie klienta nigdy nie usuwa wynajmu.
  clientId        String?
  // Wniosek 23: klient zapisany w wydarzeniu Google (extendedProperties albo
  // znacznik [klient:<id>] w opisie) i seria wydarzenia cyklicznego — twarde
  // klucze przypisania przy synchronizacji.
  eventClientId    String?  @db.VarChar(191)
  recurringEventId String?  @db.VarChar(191)
  clientContactId String?
  // Adres z „Paszportu dostawy” klienta (karta klienta, etap B). null = adres
  // domyślny klienta; tekst deliveryAddress zostaje (kalendarz, nawigacja).
  deliveryAddressId String?

  device          Device                 @relation(fields: [deviceId], references: [id])
  driver          User?                  @relation("RentalDriver", fields: [driverId], references: [id])
  vehicle         Vehicle?               @relation(fields: [vehicleId], references: [id])
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContact   ClientContact?         @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  deliveryAddressRef ClientDeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  reminderRules   ReminderRule[]
  messages        Message[]
  finance         RentalFinance?
  lead            Lead?
  deliveryFeedback DeliveryFeedback[]

  @@unique([googleCalendarId, googleEventId])
  @@index([clientId])
  @@index([clientContactId])
  @@index([deliveryAddressId])
  @@map("rentals")
}

model ReminderRule {
  id           String         @id @default(uuid())
  rentalId     String
  daysBefore   Int
  channel      Channel
  messageBody  String         @db.Text
  status       ReminderStatus @default(SCHEDULED)
  scheduledFor DateTime
  sentAt       DateTime?
  errorMessage String?        @db.Text
  edited       Boolean        @default(false)

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("reminder_rules")
}

model Message {
  id                String        @id @default(uuid())
  rentalId          String?
  userId            String?
  channel           Channel
  recipient         String
  subject           String?       @db.Text
  body              String        @db.Text
  status            MessageStatus
  providerMessageId String?
  errorMessage      String?       @db.Text
  sentAt            DateTime      @default(now())

  rental Rental? @relation(fields: [rentalId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  // SMS wysłany z karty klienta / sygnału bez wynajmu (CRM, prompt 2).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("messages")
}

model MessageTemplate {
  id      String  @id @default(uuid())
  key     String  @unique
  label   String
  channel Channel
  subject String? @db.Text
  body    String  @db.Text

  @@map("message_templates")
}

model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

model SyncLog {
  id              String        @id @default(uuid())
  deviceId        String?
  direction       SyncDirection
  eventsProcessed Int
  status          SyncStatus
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())

  device Device? @relation(fields: [deviceId], references: [id])

  @@map("sync_logs")
}

enum ReminderCheckSource {
  CRON
  MANUAL
}

model ReminderCheckLog {
  id             String              @id @default(uuid())
  rentalsChecked Int
  dueCount       Int
  sentCount      Int
  failedCount    Int
  queuedCount    Int                 @default(0)
  source         ReminderCheckSource @default(CRON)
  createdAt      DateTime            @default(now())

  @@map("reminder_check_logs")
}

// --- Moduł finansowy wydarzeń ---
// Reguły biznesowe: docs/finanse-wynajmu/prompt-claude-code-finanse-wynajmu.md
// Cała logika liczenia: src/lib/pricing/ (suma zawsze przeliczana server-side).

model RentalFinance {
  id       String @id @default(cuid())
  rentalId String @unique
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  // --- cena bazowa (wynajem LUB szkolenie) ---
  baseRentalPriceNet         Decimal     @db.Decimal(10, 2)
  baseRentalPriceSource      PriceSource
  baseRentalPriceOverrideNote String?    @db.Text

  // --- wariant głowicy wybrany przy wynajmie (odzwierciedla Device.variantOptions) ---
  deviceVariant String? // np. "single_flex", "double", "dye_vl_ipixel" — null dla *_FLAT i SZKOLENIA

  // --- liczniki impulsów (LightSheer "single_flex" ORAZ Alma Harmony zawsze) ---
  pulseCounterStart      Int?
  pulseCounterEnd        Int?
  pulseCalculationStatus PulseCalculationStatus?

  // --- dopłata za impulsy Alma Harmony (DODATKOWA do baseRentalPriceNet) ---
  // Dla LightSheer flex impulsy określają baseRentalPriceNet bezpośrednio — tu zostaje null.
  pulseSurchargeNet Decimal? @db.Decimal(10, 2)

  // --- nakładka HS (tylko LightSheer wariant "double") ---
  capUsedHS  Boolean?
  capCountHS Int      @default(1) // ile nakładek HS zużyto (gdy capUsedHS); kierowca może zmienić z 1 na 2+
  capFeeNet  Decimal? @db.Decimal(10, 2) // snapshot z PricingSetting w momencie zaznaczenia (za 1 szt.)

  // --- membrany Cooltech (tylko COOLTECH_FLAT) — ten sam wzorzec co nakładka HS ---
  membraneUsed    Boolean?
  membraneCount   Int      @default(1) // ile membran zużyto (gdy membraneUsed); kierowca może zmienić z 1 na 2+
  membraneFeeNet  Decimal? @db.Decimal(10, 2) // snapshot z PricingSetting w momencie zaznaczenia (za 1 szt.)

  // --- VAT ---
  vatApplicable Boolean @default(false)
  vatRate       Decimal @default(23) @db.Decimal(5, 2) // per-wydarzenie, na wypadek zmiany stawki

  // --- kwota na fakturę (etap C): null = całość (gdy VAT), liczba = część
  // netto na FV (warunki „część”, np. Kolber); bez VAT zawsze 0 na FV.
  invoiceNet Decimal? @db.Decimal(10, 2)
  // Warunki „część” bez ustalonej kwoty (wniosek 17): VAT tak, ale kwota na FV
  // do ustalenia — nie liczymy jej jako „całość na FV”. Czyści ją wpisanie
  // części albo świadome „FV na całość” w formularzu.
  invoiceNetPending Boolean @default(false)

  // --- suma WYNAJMU — przeliczana i zapisywana po każdej zmianie, NIE ufać wartości z klienta ---
  // Gdy transportPaidSeparately = false, zawiera też transport (jak dawniej).
  totalNet   Decimal @db.Decimal(10, 2)
  totalGross Decimal @db.Decimal(10, 2)

  // --- płatność WYNAJMU ---
  paymentMethod PaymentMethod

  // --- czas pracy kierowcy (minuty) — wpisywany ręcznie przez KIEROWCĘ ---
  // Tylko zbieranie danych pod przyszły moduł kosztów bezpośrednich; nigdzie
  // jeszcze nie raportowane.
  deliveryDurationMinutes Int?
  pickupDurationMinutes   Int?

  // --- pojazd odbioru, gdy inny niż dostawy ---
  // Dostawa zawsze jedzie pojazdem z Rental.vehicleId (ustala biuro). Odbiór
  // domyślnie tym samym — pickupVehicleId = null. Kierowca może zaznaczyć, że
  // odbiór był innym pojazdem (suwak w widoku kierowcy) — wtedy tu ląduje
  // drugi pojazd. Podstawa do liczenia kosztu paliwa PER ETAP (patrz
  // src/lib/costs/calc.ts — każdy etap to osobna trasa tam-i-z-powrotem).
  pickupVehicleId String?
  pickupVehicle   Vehicle? @relation("RentalFinancePickupVehicle", fields: [pickupVehicleId], references: [id])

  // --- uwagi kierowcy PER ETAP (zastępują dawne Rental.driverNotes) ---
  // Dostawa i odbiór mogą mieć zupełnie inny kontekst (np. "dostawa
  // połączona z innym klientem"), więc jedna wspólna uwaga nie wystarczała.
  deliveryNotes String? @db.Text
  pickupNotes   String? @db.Text

  // --- potwierdzenie odbioru — JEDYNY jawny, globalny sygnał "rozliczenie
  // kompletne", niezależny od pojedynczych pól (nakładka/membrana itp., które
  // zapisują się przy KAŻDYM autosave, nie tylko świadomym zakończeniu).
  // Ustawiane jednym, sticky przyciskiem na dole panelu kierowcy — przy
  // płatności gotówką ten sam klik oznacza też "gotówka odebrana" (nie ma już
  // osobnego pola cashCollected: przy PaymentMethod.CASH gotówkę uznajemy za
  // odebraną dokładnie wtedy, gdy confirmedAt != null). Jedyne źródło prawdy
  // dla "brak raportu" (src/lib/report-alerts.ts) i podziału przychodu na
  // rzeczywisty/preliminowany (src/lib/revenue/aggregate.ts).
  confirmedAt DateTime?

  // --- transport ---
  // Kwota netto transportu (dawniej wolny tekst na Rental.transportPrice).
  transportPriceNet       Decimal?       @db.Decimal(10, 2)
  // true = transport rozliczany osobno: własny VAT (zawsze 23%) i własny
  // sposób płatności, poza sumą wynajmu. false = wpada do sumy wynajmu.
  transportPaidSeparately Boolean        @default(false)
  transportVatApplicable  Boolean        @default(false) // tylko gdy transportPaidSeparately
  transportPaymentMethod  PaymentMethod? // tylko gdy transportPaidSeparately
  transportCashCollected  Boolean?       // potwierdzenie odbioru gotówki za transport przez kierowcę
  // Zdenormalizowana suma transportu (tylko gdy transportPaidSeparately).
  transportTotalNet       Decimal?       @db.Decimal(10, 2)
  transportTotalGross     Decimal?       @db.Decimal(10, 2)

  // --- faktura VAT (Fakturownia) — wystawiana ręcznym przyciskiem przez biuro,
  // tylko gdy vatApplicable (niezależnie od sposobu płatności). Wysyłka do
  // KSeF NIE jest tu obsługiwana automatycznie (ma zostać ręczna/na żądanie
  // z dashboardu /finanse/faktury) — patrz src/lib/integrations/fakturownia.ts.
  fakturowniaInvoiceId     Int?
  fakturowniaInvoiceNumber String?
  invoiceIssuedAt          DateTime?
  // Ostatni błąd/status próby wystawienia (np. "nie znaleziono kontrahenta") —
  // czyszczony przy udanym wystawieniu.
  invoiceError             String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rental_finance")
}

// Status "zapłacona" dla DOWOLNEJ faktury z działu w Fakturowni — CELOWO
// niezależny od RentalFinance/Rental. Większość faktur w dziale to faktury
// wystawione ręcznie w Fakturowni, zanim ta integracja powstała (nie mają
// odpowiadającego wynajmu w tej apce), więc śledzenie płatności musi działać
// wyłącznie po ID faktury z Fakturowni, nie przez powiązanie z wynajmem.
// Fakturownia sama nie zna statusu płatności (brak płatnego połączenia z
// bankiem) — ustalamy to sami: ręczny przełącznik albo dopasowanie
// wgranego wyciągu bankowego (dashboard /finanse/faktury).
model FakturowniaPayment {
  fakturowniaInvoiceId Int      @id
  paidAt               DateTime // z wyciągu: data przelewu; ręcznie: chwila oznaczenia
  // Przelew z wyciągu, który opłacił fakturę (null = oznaczenie ręczne /
  // wgranie sprzed zapisywania przelewów).
  bankTransferId       String?
  // Jak zapłacono: TRANSFER (przelew z wyciągu), CASH (gotówka — oznaczenie
  // ręczne z karty klienta), MANUAL (przełącznik na /finanse/faktury).
  // null = wpis sprzed rozróżnienia.
  method               String?  @db.VarChar(12)
  receivedBy           String? // gotówka: kto przyjął (np. kierowca)
  markedById           String? // kto oznaczył w panelu
  note                 String?  @db.Text
  updatedAt            DateTime @updatedAt

  @@map("fakturownia_payments")
}

// Historia wgranych wyciągów bankowych (/finanse/faktury) — bez tego wynik
// wgrania znikał po odświeżeniu strony, nie było śladu KIEDY i JAKI plik
// wgrano. Same liczby podsumowania (nie pełna lista dopasowań per wiersz —
// te i tak są odtwarzalne na żądanie z Fakturowni + FakturowniaPayment).
model BankStatementUpload {
  id                 String   @id @default(cuid())
  fileName           String
  uploadedAt         DateTime @default(now())
  uploadedByUserId   String?
  transactionsParsed Int
  autoMatched        Int
  ambiguous          Int
  noMatch            Int
  // Okres operacji w pliku (pierwsza / ostatnia data) — „wpłaty aktualne na”.
  periodFrom         DateTime?
  periodTo           DateTime?

  @@map("bank_statement_uploads")
}

// Przelewy PRZYCHODZĄCE z wgranych wyciągów (wniosek 6) — żeby karta
// klienta i agent widzieli, czym opłacono fakturę, a co zostało
// niedopasowane. Wydatki nie są zapisywane. Ten sam przelew z kolejnego,
// nakładającego się wyciągu nie dubluje się (hash).
model BankTransfer {
  id                   String    @id @default(cuid())
  uploadId             String?
  bookedAt             DateTime // data operacji (dzień, 12:00 UTC)
  amount               Decimal   @db.Decimal(12, 2)
  description          String    @db.Text
  hash                 String    @unique @db.VarChar(64)
  fakturowniaInvoiceId Int? // dopasowana faktura
  matchState           String    @default("NONE") @db.VarChar(12) // AUTO | MANUAL | AMBIGUOUS | NONE
  candidates           Json? // AMBIGUOUS: [fakturowniaInvoiceId]
  matchedByUserId      String?
  matchedAt            DateTime?
  createdAt            DateTime  @default(now())

  @@index([bookedAt])
  @@index([fakturowniaInvoiceId])
  @@index([matchState])
  @@map("bank_transfers")
}

model PriceRule {
  id              String                @id @default(cuid())
  pricingCategory DevicePricingCategory
  variant         String? // null dla kategorii *_FLAT
  durationDays    Int
  priceNet        Decimal               @db.Decimal(10, 2)

  @@unique([pricingCategory, variant, durationDays])
  @@map("price_rules")
}

model PulseTier {
  id                   String                @id @default(cuid())
  pricingCategory      DevicePricingCategory // dziś realnie tylko LIGHTSHEER_VARIANT
  durationDays         Int
  order                Int // kolejność progu w ramach danego durationDays, rosnąco
  maxPulses            Int? // null = ostatni / otwarty próg
  priceNet             Decimal               @db.Decimal(10, 2)
  isOverflowTier       Boolean               @default(false)
  overflowStepPulses   Int? // tylko gdy isOverflowTier
  overflowStepPriceNet Decimal?              @db.Decimal(10, 2) // tylko gdy isOverflowTier

  @@unique([pricingCategory, durationDays, order])
  @@map("pulse_tiers")
}

model PricingSetting {
  id        String   @id @default(cuid())
  key       String   @unique // "cap_fee_hs_net" | "vat_rate_default" | "alma_pulse_rate_net" | "fuel_price_per_liter"
  value     Decimal  @db.Decimal(12, 4)
  // Do wskaźnika "ostatnia aktualizacja: X dni temu" na /ustawienia/pojazdy
  // (fuel_price_per_liter — jeden parametr aktualizowany co tydzień zamiast
  // osobnego kosztu/km per pojazd, patrz Vehicle.fuelConsumptionL100km).
  updatedAt DateTime @default(now()) @updatedAt

  @@map("pricing_settings")
}

// ==================== Moduł kosztów (docs/prompt-claude-code-dashboard-kosztow.md) ====================

model Vehicle {
  id          String   @id @default(cuid())
  name        String // np. "Skoda Fabia"
  plateNumber String
  // Spalanie — stała cecha pojazdu, zmienia się rzadko (w przeciwieństwie do
  // ceny paliwa, która jest teraz JEDNYM współdzielonym parametrem,
  // PricingSetting["fuel_price_per_liter"], nie polem per pojazd — ADMIN
  // aktualizuje cenę paliwa raz, dla całej floty naraz, zamiast osobno
  // przeliczać koszt/km w każdym aucie. koszt/km = spalanie/100 * cena paliwa.
  fuelConsumptionL100km Decimal  @db.Decimal(5, 2)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rentals              Rental[]
  costs                Cost[]
  pickupForRentals     RentalFinance[] @relation("RentalFinancePickupVehicle")
  fuelInvoices         FuelInvoice[]

  @@map("vehicles")
}

enum CostScope {
  GENERAL
  VEHICLE
  DEVICE
}

// Zarządzana tabela (nie luźny string na Cost) — /ustawienia/kategorie-kosztow,
// sekcja 6. Zmiana nazwy aktualizuje się wszędzie od razu (jeden wiersz).
model CostCategory {
  id        String    @id @default(cuid())
  name      String
  scope     CostScope
  // Dezaktywacja, NIE usuwanie — API musi odrzucić twarde usunięcie kategorii
  // z choć jednym powiązanym Cost (sekcja 6). Nieaktywna znika z dropdownu
  // formularza „Dodaj koszt", ale istniejące Cost nadal ją pokazują.
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  costs Cost[]

  @@unique([name, scope])
  @@map("cost_categories")
}

// Pojedynczy wpis kosztowy — ręcznie wpisywany przez ADMINA (z faktury).
// scope/deviceId/vehicleId/categoryId muszą być spójne, walidowane w API
// (sekcja 1.6), nie tylko w UI.
model Cost {
  id          String       @id @default(cuid())
  amount      Decimal      @db.Decimal(10, 2) // netto
  date        DateTime // data poniesienia kosztu (z faktury), nie data wpisania
  scope       CostScope
  categoryId  String
  category    CostCategory @relation(fields: [categoryId], references: [id])
  description String?      @db.Text
  deviceId    String? // tylko gdy scope = DEVICE
  device      Device?      @relation(fields: [deviceId], references: [id])
  vehicleId   String? // tylko gdy scope = VEHICLE
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([scope])
  @@index([date])
  @@index([deviceId])
  @@index([vehicleId])
  @@index([categoryId])
  @@map("costs")
}

enum FuelInvoiceMatchSource {
  AUTO   // rozpoznany automatycznie po nr rej z pola "Nr. Pojazdu" na fakturze
  MANUAL // admin poprawił/wybrał ręcznie w UI
}

// Faktura za paliwo wgrana przez ADMINA (eksport XML z Fakturowni/KSeF) —
// weryfikacja szacowanego kosztu paliwa (Vehicle.fuelConsumptionL100km ×
// odległość × cena/L, patrz src/lib/costs/calc.ts) względem realnych
// wydatków. Karty paliwowe są WSPÓLNE dla całej floty, ale stacja pyta o nr
// rej przy tankowaniu — trafia na fakturę w osobnym polu opisu, stąd
// dopasowanie po numerze rejestracyjnym, nie po koncie/karcie.
// Parser: src/lib/costs/fuel-invoice-parse.ts.
model FuelInvoice {
  id            String    @id @default(cuid())
  fileName      String
  invoiceNumber String?
  invoiceDate   DateTime?
  sellerName    String?
  amountNet     Decimal?  @db.Decimal(10, 2)
  amountGross   Decimal?  @db.Decimal(10, 2)
  currency      String?
  // Pełna treść pliku — do wglądu/debugowania parsera i ponownego
  // dopasowania, gdyby trzeba było poprawić logikę już po wgraniu.
  rawXml        String    @db.LongText
  // Surowa treść pola "Nr. Pojazdu" z faktury (np. "DW9FF41 (PV ...)"),
  // zanim wyciągnięto sam numer — do wglądu, gdy dopasowanie zawiedzie.
  vehiclePlateRaw String?
  vehicleId     String? // null = nie rozpoznano / nie dotyczy jednego pojazdu
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  matchSource   FuelInvoiceMatchSource?
  uploadedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([vehicleId])
  @@index([invoiceDate])
  @@map("fuel_invoices")
}

// ---------------------------------------------------------------------------
// CRM — klienci (etap 1, docs: prompt-claude-code-crm-1-klienci.md)
// ---------------------------------------------------------------------------
// Na razie wyłącznie DODANE: żaden istniejący ekran ani zapytanie ich nie
// czyta. Status klienta (Potencjalny/Nowy/Stały/…) NIE jest tu zapisywany —
// liczony przy odczycie z historii wynajmów (src/lib/clients/status.ts).

// Jedyna ręczna wartość statusu — reszta statusów wynika z wynajmów.
enum ClientStatusOverride {
  NIE_KONTAKTOWAC
}

enum DeviceInterest {
  LIGHTSHEER // Desire / Quattro / Light
  LIGHTSHEER_ET400
  ALMA_HARMONY
  COOLTECH
  RESURFX
  OBSERV
  SZKOLENIE
}

enum ClientSource {
  FORMULARZ_WWW
  TELEFON
  POLECENIE
  GOOGLE_ADS
  META
  POWRACAJACY
  INNE
}

enum ClinicType {
  GABINET_KOSMETOLOGICZNY
  KLINIKA_MEDYCYNY_ESTETYCZNEJ
  SALON_BEAUTY
  KOSMETOLOG_MOBILNY
  INNE
}

// Gabinet / firma. Gdy klientka nie ma firmy, klient jest jednoosobowy, a
// `name` to jej imię i nazwisko.
model Client {
  id                String                @id @default(cuid())
  name              String
  nip               String? // tylko cyfry — normalizowane przy zapisie
  street            String?
  zip               String?
  city              String?
  // Region do filtra listy (src/lib/clients/region.ts) — pole liczone z kodu
  // pocztowego / miasta, odświeżane przy odczycie listy, gdy się rozjedzie.
  region            String?               @db.VarChar(16)
  // Mapa klientek (etap 1): współrzędne adresu dostawy (albo adresu firmy)
  // z Nominatim (OpenStreetMap) albo przesunięte ręcznie na mapie.
  lat               Float?
  lng               Float?
  geoSource         String?               @db.VarChar(16) // NOMINATIM | MANUAL
  geoPrecision      String?               @db.VarChar(16) // ADRES | MIEJSCOWOSC
  geoQuery          String?               @db.VarChar(255) // adres, dla którego liczono (zmiana adresu = ponowne liczenie)
  geocodedAt        DateTime?
  country           String?               @default("Polska")
  transportPriceNet Decimal?              @db.Decimal(10, 2) // dawne HubSpot „ustalona_cena_transportu”
  // Od kiedy obowiązuje kwota transportu (wniosek 15) — ustawiana przy zmianie
  // kwoty; historia zmian w dzienniku (change_logs, pole transportPriceNet).
  transportPriceSince DateTime?
  distanceKm        Decimal?              @db.Decimal(6, 1) // ostatnia znana odległość (z wynajmów)
  clinicType        ClinicType?
  source            ClientSource?
  deviceInterests   Json? // DeviceInterest[]
  statusOverride    ClientStatusOverride?
  // Ostatni policzony status (wniosek 20) — tylko do dziennika zmian: codzienny
  // cron porównuje z bieżącą regułą i zapisuje zmianę (przed → po). Status
  // nadal liczony przy odczycie (status.ts), to pole go nie ustala.
  lastStatus        String?              @db.VarChar(16)
  notes             String?               @db.Text
  // Kwalifikacja (prompt 2 v2, 1.0): sygnał to zapytanie, klient to gabinet,
  // z którym faktycznie był kontakt. null = „kontakt z zapytania” (nie na
  // liście klientów). Wynajem / historia z kalendarza / faktura kwalifikują
  // zawsze — liczone przy odczycie (src/lib/clients/qualification.ts).
  qualifiedAt       DateTime?
  qualifiedReason   String? // CALL | EMAIL_REPLY | RENTAL | HISTORY | MANUAL | BACKFILL | HUBSPOT

  // Archiwum (Porządki, etap 4): rekord zarchiwizowany znika z list, sygnałów,
  // wyszukiwania i dopasowań; synchronizacja aktualizuje go w archiwum.
  // Archiwizuje i przywraca ADMIN. Powód: src/lib/porzadki/archive.ts.
  archivedAt        DateTime?
  archiveReason     String?  @db.VarChar(32)
  archiveNote       String?  @db.Text
  archivedById      String?
  archiveBatch      String?  @db.VarChar(64)

  // Mapowanie na HubSpot — import, deduplikacja i link „Otwórz w HubSpot” w
  // okresie przejściowym. hubspotSnapshot = wartości pól z ostatniej udanej
  // synchronizacji, podstawa scalania zmian bez cichego nadpisywania.
  hubspotCompanyId String? @unique
  legacyHubspotTag String? // surowa wartość HubSpot „tagi” — tylko do wglądu
  hubspotSnapshot  Json?

  // Karta klienta, sekcja 3 (prompt-code-karta-klienta.md, model pól
  // karta-klienta-model-pol.html). Wszystkie opcjonalne; walidacja i
  // kształty JSON: src/lib/clients/profile-fields.ts.
  shortName          String? // nazwa robocza („MiWiNi”)
  regon              String?   @db.VarChar(14)
  legalForm          String?   @db.VarChar(64) // JDG, sp. z o.o. …
  businessStartDate  DateTime?
  pkd                Json? // [{ code, name?, main? }]
  vatStatus          String?   @db.VarChar(32) // Czynny / Zwolniony / Niezarejestrowany
  bankAccounts       Json? // [numer rachunku] — z Białej listy
  deliveryAddress    String?   @db.Text // adres dostawy (gabinet ≠ siedziba)
  deliveryNotes      Json? // { entrance, floor, parking, power, receiver }
  services           Json? // [usługa]
  openingHours       String?   @db.Text
  links              Json? // { www, instagram, facebook, booksy, fresha }
  ownDevices         String?   @db.Text
  seasonality        String?   @db.Text
  agreedPrice        Decimal?  @db.Decimal(10, 2) // cena ustalona netto — sam wynajem (transport: transportPriceNet)
  paymentForm        String?   @db.VarChar(12) // GOTOWKA | PRZELEW | OBA — jak zwykle płaci
  paymentTerms       String?   @db.Text // uwagi do warunków (dawniej „forma i termin płatności”)
  // Warunki handlowe (karta klienta, etap C). Ceny: ClientPrice; brak wiersza
  // = cennik ogólny (Ustawienia → Cennik). Transport: transportPriceNet.
  paymentTermDays    Int? // termin płatności przelewu (dni)
  invoiceMode        String?   @db.VarChar(8) // FULL | PARTIAL | NONE — ile idzie na fakturę
  invoicePartDefault Decimal?  @db.Decimal(10, 2) // netto na FV przy PARTIAL
  pulsesCharged      Boolean? // czy doliczać impulsy (Alma), null = do potwierdzenia
  pulseRateNet       Decimal?  @db.Decimal(10, 4) // stawka za impuls, gdy inna niż w cenniku
  invoiceEmail       String?
  // Nabywca faktury inny niż gabinet (np. SHA → Dominika Twardowska,
  // Morawska → P.H.U. Zibi Anna Morawska) — karta klienta, „Dane do faktury”.
  invoiceBuyerName   String?   @db.VarChar(191)
  invoiceBuyerNip    String?   @db.VarChar(16)
  frameAgreement     Json? // { fileId, name, signedAt, note, url } — umowa ramowa / kaucja (plik: ClientFile)
  marketingConsent   Json? // { email, sms, date, source }
  smsReminders       Boolean?
  googleReview       Json? // { askedAt, given }
  nextStepText       String?   @db.Text // „Następny krok” (baner na karcie)
  nextStepDueAt      DateTime?
  // Pochodzenie pól: { [pole]: { source, sourceRef, verifiedAt, verifiedBy,
  // lockedManual } }. lockedManual = synchronizacja z HubSpotem i
  // uzupełnianie po NIP nie nadpisują pola.
  fieldMeta          Json?
  enrichedAt         DateTime? // ostatnie uzupełnienie po NIP (Biała lista / CEIDG)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities ClientOpportunity[]
  contacts ClientContact[]
  rentals  Rental[]
  history  RentalHistory[]
  aliases  ClientAlias[]
  invoices ClientInvoice[]
  leads    Lead[]
  leadActivities LeadActivity[]
  tasks    Task[]
  messages Message[]
  emails   EmailMessage[]
  changeLogs ChangeLog[]
  changeProposals ChangeProposal[]
  proposalLinks ProposalClient[]
  remarks  Remark[]
  deliveryAddresses ClientDeliveryAddress[]
  prices   ClientPrice[]

  @@index([nip])
  @@index([name])
  @@index([archivedAt])
  @@map("clients")
}

// Paszport dostawy (karta klienta, etap B): adresy, pod które jedzie kierowca
// — wiele na klienta (np. Wieliczka i Kraków). Domyślny podstawia się w
// rezerwacji i na mapie. Odległość i czas z trasy OSRM od bazy (Ustawienia →
// Cennik), liczone przy zapisie adresu. Stare pola Client.deliveryAddress /
// deliveryNotes / openingHours / distanceKm są lustrem adresu domyślnego.
model ClientDeliveryAddress {
  id                String    @id @default(cuid())
  clientId          String
  label             String    @db.VarChar(64) // Gabinet, Wieliczka…
  isDefault         Boolean   @default(false)
  street            String?   @db.VarChar(191)
  zip               String?   @db.VarChar(8)
  city              String?   @db.VarChar(191)
  lat               Float?
  lng               Float?
  geoPrecision      String?   @db.VarChar(16) // ADRES | MIEJSCOWOSC
  geoQuery          String?   @db.VarChar(255) // adres, dla którego liczono
  geoState          String?   @db.VarChar(64) // województwo z geokodowania (region)
  geoCounty         String?   @db.VarChar(64) // powiat z geokodowania
  distanceKm       Decimal?  @db.Decimal(6, 1) // trasa od bazy (OSRM) albo dawna wartość z wynajmów
  durationMin       Int?
  routeCalculatedAt DateTime?
  // Na miejscu — widoczne dla kierowcy.
  entrance          String?   @db.Text
  floor             String?   @db.Text
  parking           String?   @db.Text
  power             String?   @db.Text
  receiver          String?   @db.Text
  openingHours      String?   @db.Text
  usualStartTime    String?   @db.VarChar(16)
  officeNotes       String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rentals  Rental[]
  feedback DeliveryFeedback[]

  @@index([clientId])
  @@map("client_delivery_addresses")
}

// Warunki handlowe (karta klienta, etap C): cena netto wynajmu klienta dla
// urządzenia / wariantu i liczby dni. Ma pierwszeństwo przed cennikiem ogólnym
// przy tworzeniu rezerwacji. Kody urządzeń: src/lib/clients/terms-rules.ts.
model ClientPrice {
  id        String   @id @default(cuid())
  clientId  String
  device    String   @db.VarChar(24) // LS_1G, LS_2G, ET400, ALMA_DYEVL, … SZKOLENIE
  days      Int
  priceNet  Decimal  @db.Decimal(10, 2)
  source    String?  @db.VarChar(32) // OFERTA | UMOWA | HISTORIA | USTALENIE | AGENT
  sourceRef String?  @db.VarChar(191) // np. „oferta 30.10.2025”, nr paczki
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, device, days])
  @@map("client_prices")
}

// Uwagi kierowcy o adresie — wpisywane po dostawie / odbiorze (widok
// kierowcy), na karcie klienta ostatnie 3, starsze pod „więcej”.
model DeliveryFeedback {
  id        String   @id @default(cuid())
  addressId String
  rentalId  String?
  driverId  String?
  text      String   @db.Text
  createdAt DateTime @default(now())

  address ClientDeliveryAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  rental  Rental?               @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  driver  User?                 @relation("DeliveryFeedbackDriver", fields: [driverId], references: [id], onDelete: SetNull)

  @@index([addressId, createdAt])
  @@index([rentalId])
  @@map("delivery_feedback")
}

model ClientContact {
  id               String  @id @default(cuid())
  clientId         String
  client           Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName        String?
  lastName         String?
  phone            String? // E.164 (+48…), normalizePolishPhone z src/lib/reminders.ts
  // Drugi numer (np. „prywatny” obok „gabinet”) — wyszukiwany na liście,
  // SMS domyślnie na pierwszy. Etykieta z listy albo własna.
  phone2           String?
  phone2Label      String?
  email            String?
  role             String? // np. „właścicielka”, „kosmetolog”
  isPrimary        Boolean @default(false) // dokładnie jedna główna osoba na klienta
  hubspotContactId String? @unique
  hubspotSnapshot  Json?

  // Karta klienta, sekcja 3: role jako tagi (owner / decides / invoices /
  // reception / cosmetologist), kanał, forma zwracania się, szkolenia.
  roles            Json?
  preferredChannel String?  @db.VarChar(64)
  salutation       String? // „Pani Basiu”
  trainedOn        Json? // [{ device, date }]
  fieldMeta        Json? // pochodzenie pól, jak Client.fieldMeta

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals Rental[]
  leads   Lead[]

  @@index([clientId])
  @@index([email])
  @@index([phone])
  @@map("client_contacts")
}

// Szanse sprzedaży klienta (karta, sekcja „Szanse sprzedaży”; MCP
// szansa_dodaj). Np. „Cooltech – modelowanie ciała”, oferta 03.2025,
// wrócić 02.2027.
// Pliki klienta (karta, „Warunki handlowe”): skan umowy ramowej / kaucji.
// Trzymane w bazie (brak osobnego magazynu plików na hostingu), maks. 8 MB.
model ClientFile {
  id           String   @id @default(cuid())
  clientId     String
  kind         String   @db.VarChar(24) // FRAME_AGREEMENT
  fileName     String
  mimeType     String   @db.VarChar(100)
  size         Int
  data         Bytes    @db.LongBlob
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([clientId, kind])
  @@map("client_files")
}

// Lista wykluczeń domen i adresów (wniosek 7; Ustawienia → Wykluczenia).
// EXCLUDE: maile nie trafiają do panelu, kontakty i transakcje z HubSpota
// nie tworzą klientów ani sygnałów. HIDE: wątki domyślnie ukryte w historii
// klienta, chyba że dotyczą wynajmu. Reguły: src/lib/porzadki/exclusion-rules.ts.
model EmailExclusion {
  id          String   @id @default(cuid())
  kind        String   @db.VarChar(16) // EXCLUDE | HIDE
  value       String   @unique @db.VarChar(191) // domena (bez @) albo pełny adres
  note        String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  @@map("email_exclusions")
}

model ClientOpportunity {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  device      String // urządzenie / temat szansy
  stage       String    @db.VarChar(32) // pomysl | rozmowa | oferta | decyzja | wygrana | przegrana
  chance      String?   @db.VarChar(16) // wysoka | srednia | niska | sprawdzic
  lastContact DateTime?
  returnAt    DateTime? // kiedy wrócić
  note        String?   @db.Text
  source      String?   @db.Text // źródło (agent: wymagane)
  createdById String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([returnAt])
  @@map("client_opportunities")
}

// ---------------------------------------------------------------------------
// CRM — historia klienta (docs/crm/prompt-claude-code-crm-3-historia.md).
// Warstwa TYLKO DO ODCZYTU: osobne tabele, nigdy Rental — historia nie może
// uruchomić przypomnień SMS, alertów, zadań kierowcy ani zmienić przychodów.

enum HistoryMatchMethod {
  NIP // faktura: NIP nabywcy = Client.nip
  EMAIL // adres e-mail osoby kontaktowej
  PHONE // numer telefonu w opisie wydarzenia
  NAME_AUTO // dopasowanie nazwy powyżej progu pewności
  MANUAL // potwierdzone / wybrane ręcznie przez biuro
  RENTAL // faktura wystawiona z panelu dla wynajmu (RentalFinance.fakturowniaInvoiceId)
  DOMAIN // e-mail z nieznanego adresu w firmowej domenie klienta — propozycja nowej osoby
}

enum HistoryMatchState {
  AUTO // przypisane automatycznie (wysoka pewność)
  SUGGESTED // propozycja do potwierdzenia
  CONFIRMED // potwierdzone przez człowieka
  IGNORED // nie dotyczy klienta (serwis, blokada terminu, prywatne)
  UNMATCHED // brak propozycji
}

// Wydarzenie z kalendarza urządzenia sprzed okna synchronizacji (device-sync.ts).
model RentalHistory {
  id               String              @id @default(cuid())
  deviceId         String
  device           Device              @relation(fields: [deviceId], references: [id])
  googleCalendarId String
  googleEventId    String
  title            String
  description      String?             @db.Text
  startsAt         DateTime
  endsAt           DateTime
  kind             String // "WYNAJEM" | "SZKOLENIE" | "INNE" — src/lib/history/normalize-title.ts
  // Znormalizowany tytuł — klucz grupowania na /klienci/dopasowania i aliasów.
  titleKey         String              @db.VarChar(191)
  // Kandydaci dla SUGGESTED: [{ clientId, score }] (maks. 3).
  candidates       Json?
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matchMethod      HistoryMatchMethod?
  matchState       HistoryMatchState   @default(UNMATCHED)
  matchScore       Float?
  matchedByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([googleCalendarId, googleEventId])
  @@index([clientId])
  @@index([matchState])
  @@index([titleKey])
  @@map("rental_history")
}

// Nauczone z potwierdzeń: znormalizowany tytuł → klient (prompt 3, 2.3 pkt 4).
model ClientAlias {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  alias           String   @unique @db.VarChar(191)
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([clientId])
  @@map("client_aliases")
}

// Faktury z Fakturowni jako historia klienta (prompt 3B). Kopia metadanych —
// dashboard /finanse/faktury dalej czyta Fakturownię na żywo i tej tabeli
// nie używa.
model ClientInvoice {
  id                   String              @id @default(cuid())
  // Faktury z Excela (sprzed Fakturowni, wniosek 9) mają UJEMNY identyfikator
  // liczony z numeru (03/01/2026 → -202601003) — src/lib/invoicing/excel-invoice.ts.
  fakturowniaInvoiceId Int                 @unique
  source               String              @default("FAKTUROWNIA") @db.VarChar(16) // FAKTUROWNIA | EXCEL
  sourceFile           String?             @db.VarChar(191) // nazwa pliku Excela
  number               String
  issueDate            DateTime
  sellDate             DateTime // data sprzedaży = data usługi — porównanie z wynajmami (±7 dni)
  buyerName            String
  buyerTaxNo           String? // znormalizowany NIP (same cyfry)
  buyerKey             String              @db.VarChar(191) // znormalizowana nazwa nabywcy — alias / dopasowanie
  totalNet             Decimal             @db.Decimal(10, 2)
  totalGross           Decimal             @db.Decimal(10, 2)
  positionsSummary     String?             @db.Text // nazwy pozycji — do rozpoznania urządzenia
  paymentTo            DateTime? // termin płatności z Fakturowni (payment_to) — status „po terminie”
  paymentType          String? // forma płatności z Fakturowni (transfer / cash / …)
  clientId             String?
  client               Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rentalId             String? // faktura wynajmu z panelu — nie liczona drugi raz
  candidates           Json?
  matchMethod          HistoryMatchMethod?
  matchState           HistoryMatchState   @default(UNMATCHED)
  matchScore           Float?
  matchedByUserId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([clientId])
  @@index([buyerTaxNo])
  @@index([matchState])
  @@map("client_invoices")
}

// ---------------------------------------------------------------------------
// CRM — Sygnały (docs/crm/prompt-claude-code-crm-2-sygnaly.md). Lejek
// sprzedaży: transakcje z HubSpota (formularze WWW przez n8n i ręczne) +
// sygnały dodane w panelu. Po imporcie etap prowadzi panel (ustalone
// 26.09.2026); z HubSpota dochodzą nowe transakcje i notatki.

enum LeadStage {
  SYGNAL // nowy, nikt jeszcze nie rozmawiał
  WYWIAD // rozmowa odbyta, klientka zainteresowana
  OFERTA // oferta wysłana
  REZERWACJA // termin potwierdzony
  WYGRANA // wynajem zrealizowany
  PRZEGRANA // rezygnacja / brak kontaktu — zawsze z powodem
  ODLOZONE // lejek v2: „zła pora” — wraca w dniu returnAt (powód: postponeReason)
}

enum LeadType {
  POBRANIE_CENNIKA
  KONTAKT
  REZERWACJA_WWW
  SZKOLENIE_WWW
  TELEFON
  EMAIL
  OLX
  POLECENIE
  INNE
}

enum LostReason {
  CENA
  TERMIN_ZAJETY
  ODLEGLOSC
  KUPILA_URZADZENIE
  INNE_URZADZENIE
  BRAK_KONTAKTU
  TYLKO_CENNIK
  POZA_BRANZA
  ARCHIWUM_IMPORTU
  INNE
}

model Lead {
  id              String         @id @default(cuid())
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContactId String?
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  title           String
  type            LeadType
  stage           LeadStage      @default(SYGNAL)
  stageChangedAt  DateTime       @default(now())
  ownerId         String?
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deviceInterest  Json? // DeviceInterest[]
  requestedFrom   DateTime?
  requestedDays   Int?
  location        String?
  message         String?        @db.Text
  // Dane z formularza zapisane przy sygnale — działają także bez klienta.
  contactName     String?
  contactPhone    String? // E.164
  contactEmail    String?
  firstContactAt  DateTime? // pierwsza rozmowa/SMS/notatka — czas reakcji
  nextActionAt    DateTime? // następny krok — napędza „Na dziś”
  // Lejek (wniosek 18, etap L1): rodzaj i opis następnego kroku ustawiane
  // przez wynik kontaktu (src/lib/leads/funnel.ts), próby bez odebrania,
  // numer follow-upu oferty, ostatni kontakt, odnośnik źródła (wątek Gmail /
  // numer telefonu).
  nextStepType    String?        @db.VarChar(20) // PIERWSZY_KONTAKT | PONOWNA_PROBA | FOLLOW_UP_OFERTY | ODDZWONI | DOPYTAC | INNE
  nextStepNote    String?        @db.Text
  attempts        Int            @default(0)
  followUpNo      Int            @default(0)
  lastContactAt   DateTime?
  sourceRef       String?        @db.VarChar(191)
  lostReason      LostReason?
  lostNote        String?        @db.Text
  returnAt        DateTime?
  // Lejek v2 — Odłożone: powód (SEZON | ZBIERA_OFERTY | URLOP | REMONT | INNE).
  postponeReason  String?        @db.VarChar(32)
  // Lejek v2 — zapytanie od klientki z wynajmem w ostatnich 12 mies.: od razu
  // „W kontakcie” z krokiem „umówić termin”, poza konwersją nowych.
  returningClient Boolean        @default(false)
  rentalId        String?        @unique
  rental          Rental?        @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  // Zaległe zapytanie z 2026 z importu HubSpota — lista „Do obdzwonienia”
  // (prompt 2 v2, 1.0a) zamiast „Na dziś”. Nowe sygnały nigdy tu nie trafiają.
  callList        Boolean        @default(false)
  // Archiwum (jak na kliencie) — sygnał znika z list i „Do obdzwonienia”.
  archivedAt      DateTime?
  archiveReason   String?        @db.VarChar(32)
  archiveNote     String?        @db.Text
  archivedById    String?
  archiveBatch    String?        @db.VarChar(64)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  gclid           String?
  hubspotDealId   String?        @unique
  hubspotSnapshot Json?
  createdAt       DateTime       @default(now()) // przy imporcie = createdate transakcji
  updatedAt       DateTime       @updatedAt

  activities LeadActivity[]
  tasks      Task[]
  remarks    Remark[]

  @@index([stage])
  @@index([clientId])
  @@index([nextActionAt])
  @@index([callList])
  @@index([archivedAt])
  @@map("leads")
}

enum ActivityType {
  CALL
  CALL_NO_ANSWER
  SMS
  EMAIL
  NOTE
  STAGE_CHANGE
  SYSTEM
}

model LeadActivity {
  id                  String       @id @default(cuid())
  leadId              String?
  lead                Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type                ActivityType
  body                String?      @db.Text
  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  messageId           String?
  hubspotEngagementId String?      @unique
  createdAt           DateTime     @default(now())
  // Ostatnia edycja notatki przez autora (tylko NOTE, tylko własne).
  editedAt            DateTime?

  @@index([leadId])
  @@index([clientId])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// CRM — historia e-maili z Gmaila (prompt 3C). TYLKO METADANE i skrót z
// Gmaila: pełna treść nigdy nie trafia do bazy ani logów — karta klienta
// pobiera ją z Gmail API w chwili otwarcia wiadomości.

enum EmailDirection {
  IN // od klienta
  OUT // do klienta
}

model EmailMessage {
  id              String              @id @default(cuid())
  mailbox         String // skrzynka, z której pobrano (np. kontakt@wynajemlasera.pl)
  gmailMessageId  String
  gmailThreadId   String
  rfcMessageId    String?             @db.VarChar(512) // nagłówek Message-ID — deduplikacja między skrzynkami
  direction       EmailDirection
  fromAddress     String
  toAddresses     Json // string[]
  ccAddresses     Json?
  subject         String?             @db.Text
  snippet         String?             @db.Text // skrót z Gmaila (~200 znaków)
  hasAttachments  Boolean             @default(false)
  sentAt          DateTime
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContactId String?
  matchMethod     HistoryMatchMethod?
  // Ukryty w historii klienta (wniosek 7): EXCLUDED = domena z listy
  // wykluczeń, ENGINEERING = wątek z domeny „ukrywaj” bez słów o wynajmie,
  // MANUAL = ukryty ręcznie. null = widoczny. SHOWN = ręcznie przywrócony
  // (reguły go nie ukrywają ponownie).
  hiddenReason    String?             @db.VarChar(16)
  hiddenById      String?
  createdAt       DateTime            @default(now())

  @@unique([mailbox, gmailMessageId])
  @@index([clientId, sentAt])
  @@index([rfcMessageId])
  @@map("email_messages")
}

// ---------------------------------------------------------------------------
// Dziennik zmian (rola AGENT + „Dziennik porządków”). Jeden wpis = jedna
// zmiana jednego pola (albo jedna operacja bez pola). Wartości przed/po jako
// JSON w tekście ("null" = puste pole) — podstawa „Cofnij”. Wpisy powstają
// automatycznie w endpointach zapisu danych klientów, kontaktów, dopasowań
// i — dla roli AGENT — każdego innego zapisu (zadania, notatki, komentarze).
model ChangeLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String?
  user         User?    @relation("ChangeLogUser", fields: [userId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Nazwa klienta w chwili zmiany — ślad zostaje czytelny po usunięciu klienta.
  clientName   String?
  entity       String   @db.VarChar(32) // CLIENT | CONTACT | LEAD | HISTORY | INVOICE | TASK | NOTE | TASK_COMMENT
  entityId     String   @db.VarChar(191)
  operation    String   @db.VarChar(32) // FIELD_CHANGE | CREATE | QUALIFY | MATCH_ASSIGN | MATCH_IGNORE | MATCH_RESET | STATUS_CHANGE | UNDO …
  field        String?  @db.VarChar(64)
  before       String?  @db.Text
  after        String?  @db.Text
  source       String?  @db.Text // źródło / dowód (agent: wymagane przy zmianie danych klienta)
  confidence   String?  @db.VarChar(8) // HIGH | MEDIUM | LOW
  batch        String?  @db.VarChar(64) // paczka akceptacji, np. P-2026-09-27-01
  approvedById String?
  undoneById   String? // wpis UNDO, który cofnął ten wpis
  undoOfId     String? // (w wpisie UNDO) który wpis cofa

  @@index([clientId, createdAt])
  @@index([batch])
  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("change_logs")
}

// Komentarze do zadań (panel Zadań).
// Wniosek 22: powiązanie zadania z wynajmem / klientem / sygnałem / fakturą.
// refId bez klucza obcego (różne tabele) — brak rekordu = powiązanie pomijane.
model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(16) // RENTAL | CLIENT | LEAD | INVOICE
  refId     String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@unique([taskId, kind, refId])
  @@index([kind, refId])
  @@map("task_links")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// Porządki (docs: instrukcja „Wnioski, uwagi i dziennik porządków”). Wnioski
// o zmiany w panelu, integracjach i procesie — z workflow akceptacji. Obszar,
// typ, status i priorytet jako krótkie kody (etykiety: src/lib/porzadki/labels.ts),
// bez enumów MySQL — lista może się zmieniać bez migracji.
model Proposal {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement()) // W-0001
  title          String
  area           String   @db.VarChar(32)
  type           String   @db.VarChar(32)
  problem        String?  @db.Text
  evidence       String?  @db.Text
  scale          String?
  causes         Json? // string[] — hipoteza przyczyny
  proposal       String?  @db.Text
  priority       String   @default("MEDIUM") @db.VarChar(8) // HIGH | MEDIUM | LOW
  priorityReason String?
  blocksCleanup  Boolean  @default(false)
  status         String   @default("NOWY") @db.VarChar(16)
  decision       String?  @db.Text // decyzja / komentarz przy zmianie statusu
  authorId       String?
  author         User?    @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients   ProposalClient[]
  comments  ProposalComment[]
  statuses  ProposalStatusChange[]
  relations ProposalRelation[] @relation("ProposalRelationFrom")
  relatedBy ProposalRelation[] @relation("ProposalRelationTo")
  remarks   Remark[]

  @@index([status])
  @@index([area])
  @@map("proposals")
}

model ProposalClient {
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([proposalId, clientId])
  @@index([clientId])
  @@map("proposal_clients")
}

// Powiązanie wniosków: DUPLICATE_OF (ten jest duplikatem tamtego) |
// DEPENDS_ON | SUPERSEDES.
model ProposalRelation {
  id     String   @id @default(cuid())
  fromId String
  from   Proposal @relation("ProposalRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Proposal @relation("ProposalRelationTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   String   @db.VarChar(16)

  @@unique([fromId, toId, kind])
  @@index([toId])
  @@map("proposal_relations")
}

model ProposalComment {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([proposalId])
  @@map("proposal_comments")
}

// Historia statusów wniosku: kto, kiedy, z jakiego na jaki, komentarz.
model ProposalStatusChange {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromStatus String?  @db.VarChar(16)
  toStatus   String   @db.VarChar(16)
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([proposalId])
  @@map("proposal_status_changes")
}

// Uwaga — obserwacja / podejrzenie bez workflow realizacji; da się ją
// przekształcić we wniosek (proposalId).
model Remark {
  id         String    @id @default(cuid())
  body       String    @db.Text
  area       String?   @db.VarChar(32)
  evidence   String?   @db.Text
  status     String    @default("OPEN") @db.VarChar(8) // OPEN | CLOSED
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("remarks")
}

// Reguły porządków — ustalenia, które agent czyta przed pracą
// (np. „samo imię nigdy nie wystarcza do dopasowania”). Edytuje ADMIN.
model CleanupRule {
  id          String   @id @default(cuid())
  body        String   @db.Text
  example     String?  @db.Text
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cleanup_rules")
}

// ---------------------------------------------------------------------------
// API agenta (/api/agent/*) — tokeny przypisane do użytkownika z rolą AGENT.
// W bazie tylko skrót SHA-256 tokenu; sam token pokazywany raz przy
// utworzeniu. Unieważnienie = revokedAt (Ustawienia → Użytkownicy).
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ApiTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @db.VarChar(64)
  prefix      String    @db.VarChar(16) // początek tokenu — do rozpoznania na liście
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  // Data ważności (tokeny ręczne: wybierana przy tworzeniu; OAuth: token
  // dostępu 1 h). null = bez daty (tokeny sprzed wprowadzenia ważności).
  expiresAt   DateTime?
  // STATIC = token utworzony w Ustawieniach; OAUTH = połączenie konektora
  // (claude.ai) zatwierdzone przez ADMIN — token dostępu + odświeżający,
  // rotowane w tym samym wierszu (jedno połączenie = jeden wiersz).
  kind             String    @default("STATIC") @db.VarChar(8)
  oauthClientId    String?   @db.VarChar(191)
  refreshHash      String?   @unique @db.VarChar(64)
  refreshExpiresAt DateTime?

  calls ApiCallLog[]

  @@index([userId])
  @@map("api_tokens")
}

// Log wywołań API agenta (kto, co, kiedy) — też podstawa limitu zapytań.
model ApiCallLog {
  id         String   @id @default(cuid())
  tokenId    String
  token      ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  userId     String
  method     String   @db.VarChar(8)
  path       String   @db.VarChar(255)
  status     Int
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([tokenId, createdAt])
  @@index([createdAt])
  @@map("api_call_logs")
}

// Blokada ponownego importu z HubSpota — ID rekordów trwale usuniętych w
// panelu (kontakt, firma, transakcja). Import i synchronizacja je pomijają.
// Celowo po ID, nie po e-mailu / telefonie: nowy formularz tej samej osoby
// tworzy nowe zapytanie. W HubSpocie panel niczego nie usuwa.
model ImportBlock {
  id          String   @id @default(cuid())
  kind        String   @db.VarChar(16) // CONTACT | COMPANY | DEAL
  hubspotId   String   @db.VarChar(64)
  label       String? // nazwa w chwili usunięcia (ślad do dziennika)
  reason      String?  @db.VarChar(32)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([kind, hubspotId])
  @@map("import_blocks")
}

// OAuth dla konektora MCP (claude.ai): klienci z dynamicznej rejestracji
// (RFC 7591) i jednorazowe kody autoryzacji (PKCE S256, 10 min).
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique @db.VarChar(191)
  clientName   String?
  redirectUris Json // string[]
  createdAt    DateTime @default(now())

  @@map("oauth_clients")
}

model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique @db.VarChar(64)
  clientId      String    @db.VarChar(191)
  userId        String // konto agenta, do którego należy dostęp
  approvedById  String // ADMIN, który zatwierdził
  redirectUri   String    @db.Text
  codeChallenge String    @db.VarChar(128)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@map("oauth_codes")
}

// Kolejka propozycji zmian (Porządki, etap D): agent proponuje, ADMIN
// akceptuje (pojedynczo / hurtem) albo odrzuca z komentarzem. Akceptacja
// wykonuje zmianę od razu (dziennik: wykonał = autor, zatwierdził = ADMIN).
// Rodzaje: FIELD (pole klienta), CONTACT_FIELD (pole osoby), ARCHIVE
// (klient / sygnał do archiwum), MERGE (duplikat w klienta).
model ChangeProposal {
  id              String    @id @default(cuid())
  kind            String    @db.VarChar(16)
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId       String?
  leadId          String?
  field           String?   @db.VarChar(64)
  currentValue    String?   @db.Text // JSON — wartość w panelu w chwili zgłoszenia
  proposedValue   String?   @db.Text // JSON — proponowana (ARCHIVE: {reason,note}; MERGE: {duplicateId})
  source          String    @db.Text
  confidence      String    @db.VarChar(8) // HIGH | MEDIUM | LOW
  batch           String?   @db.VarChar(64)
  changeClass     String?   @db.VarChar(64) // np. miasto_slownik — do zatwierdzania na stałe
  status          String    @default("PENDING") @db.VarChar(12) // PENDING | ACCEPTED | REJECTED
  autoApproved    Boolean   @default(false)
  authorId        String?
  editedById      String?
  decidedById     String?
  decidedAt       DateTime?
  decisionComment String?   @db.Text
  executedAt      DateTime?
  executionError  String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([batch])
  @@index([clientId])
  @@map("change_proposals")
}

// Klasy zmian zatwierdzone na stałe — propozycje pól z tą klasą agent
// wykonuje od razu (wpisy nadal w dzienniku). Ustawia ADMIN.
model AutoApprovedClass {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@map("auto_approved_classes")
}
