generator client {
  provider = "prisma-client-js"
  // The client is generated in CI (Ubuntu) and rsynced to the cyberfolks
  // boxes — `prisma generate` can't run there under the LVE thread cap.
  // "native" covers CI's own `next build`. The two cyberfolks boxes turned
  // out to run different distros/OpenSSL versions than assumed: server 2
  // (wynajemlasera.pl) needs debian-openssl-1.1.x specifically (confirmed
  // via a live PrismaClientInitializationError in its stderr.log — CI's
  // "native" build only ships debian-openssl-3.0.x), and rhel-* is kept for
  // server 1 in case it really is CloudLinux/RHEL. (The app talks to the DB
  // via @prisma/adapter-mariadb so the native engine is normally unused, but
  // the client still probes for a matching binary at init.)
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  KIEROWCA
}

enum Channel {
  SMS
  EMAIL
}

enum ReminderStatus {
  SCHEDULED
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum MessageStatus {
  SENT
  FAILED
}

enum SyncDirection {
  PULL
  PUSH
}

enum SyncStatus {
  OK
  ERROR
}

// --- Moduł finansowy wydarzeń (patrz docs/finanse-wynajmu/) ---

enum DevicePricingCategory {
  LIGHTSHEER_VARIANT // DESIRE, LIGHT, QUATTRO — wspólna tabela cen wariantów głowicy
  LIGHTSHEER_ET400_FLAT // ET400 — cena stała, bez wariantów, bez impulsów
  ALMA_HARMONY // Alma Harmony XL Pro — wariant głowicy + zawsze dopłata za impulsy
  COOLTECH_FLAT
  RESURFX_FLAT
  OBSERV_FLAT
}

enum RentalEventType {
  WYNAJEM
  SZKOLENIE
}

enum PriceSource {
  PRICE_LIST // z tabeli PriceRule
  MANUAL // wpisana ręcznie (nadpisanie albo brak reguły)
  PULSE_CALCULATED // wyliczona z licznika impulsów (LightSheer wariant elastyczny)
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PulseCalculationStatus {
  PENDING // liczniki nieodczytane — kwota tymczasowa
  CALCULATED // liczniki wpisane, kwota faktycznie wyliczona
}

enum GrammaticalGender {
  M
  F
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STAFF)
  // ADMIN/STAFF z tą flagą mogą przełączyć aplikację w „podgląd kierowcy"
  // (rola efektywna, bez zmiany roli w bazie) — patrz src/lib/effective-role.ts.
  canActAsDriver Boolean @default(false)
  // Płeć gramatyczna — do odmiany „zlecił"/„zleciła" w liście zadań.
  grammaticalGender GrammaticalGender?
  // Stawka za godzinę pracy — TYLKO rola KIEROWCA, null dla innych. REGUŁA
  // BEZPIECZEŃSTWA (docs/prompt-claude-code-dashboard-kosztow.md, sekcja 1.4):
  // to pole i wszystko z niego wyliczone (koszt pracy kierowcy) nie może się
  // pojawić w ŻADNEJ odpowiedzi API dostępnej roli KIEROWCA — nawet dla
  // właściciela tej stawki. Sprawdzaj to przy każdym endpointzie zwracanym
  // tej roli, nie tylko ukrywaj w UI.
  hourlyRate   Decimal?  @db.Decimal(8, 2)
  // Kolor ikony kierownicy na kafelkach kalendarza (rola KIEROWCA) — żeby
  // dało się odróżnić przypisanego kierowcę na pierwszy rzut oka, bez
  // najeżdżania kursorem na tooltip (zgłoszone przez użytkownika). Hex
  // string jak Device.color; null = brak przypisanego koloru (neutralny
  // wygląd ikony, jak dotychczas).
  driverColor  String?
  invitedAt    DateTime?
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())

  messages            Message[]
  passwordResetTokens PasswordResetToken[]
  assignedRentals     Rental[]             @relation("RentalDriver")
  authoredTasks       Task[]               @relation("TaskAuthor")
  assignedTasks       Task[]               @relation("TaskAssignee")
  ownedLeads          Lead[]               @relation("LeadOwner")
  leadActivities      LeadActivity[]

  @@map("users")
}

enum TaskStatus {
  OPEN
  DONE
}

// Lista zadań zespołu — widoczna tylko w widoku admina (panel wysuwany).
// Każde zadanie ma autora (kto utworzył) i odpowiedzialnego (kto ma zrobić).
model Task {
  id          String     @id @default(uuid())
  title       String
  notes       String?    @db.Text
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  dueDate     DateTime?
  authorId    String?
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User? @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Zadanie przy sygnale / kliencie (CRM, prompt 2) — link w panelu Zadań.
  leadId   String?
  clientId String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([authorId])
  @@index([assigneeId])
  @@index([leadId])
  @@index([clientId])
  @@map("tasks")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Device {
  id               String   @id @default(uuid())
  name             String
  shortName        String
  color            String
  googleCalendarId String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  // Konfiguracja cennika — uzupełniana ręcznie przez ADMINA na /urzadzenia po
  // wdrożeniu (migracja świadomie nie zgaduje tego z nazwy urządzenia).
  pricingCategory DevicePricingCategory?
  // Dozwolone warianty głowicy dla tego egzemplarza, np. ["single_standard","single_flex","double"]
  // (LightSheer) lub ["dye_vl","dye_vl_ipixel"] (Alma). null / [] dla kategorii *_FLAT.
  variantOptions  Json?

  rentals  Rental[]
  syncLogs SyncLog[]
  costs    Cost[]
  history  RentalHistory[]

  @@map("devices")
}

model Rental {
  id                  String    @id @default(uuid())
  deviceId            String
  googleEventId       String
  googleCalendarId    String
  title               String
  description         String?   @db.Text
  startsAt            DateTime
  endsAt              DateTime
  allDay              Boolean   @default(false)
  hubspotContactId    String?
  contactNameCache    String?
  contactPhoneCache   String?
  contactEmailCache   String?
  contactCompanyCache String?
  contactAddressCache String?   @db.Text
  // raw "ustalona_cena_transportu" from the HubSpot contact, refreshed on assign
  contactTransportPriceCache String?
  // NIP kontrahenta z HubSpot, refreshed on assign — podstawa wyszukania
  // kontrahenta w Fakturowni przy wystawianiu faktury (RentalFinance.invoiceError itd.)
  contactNipCache String?
  deliveryAddress     String?   @db.Text
  deliveryTime        String?
  pickupTime          String?
  // editable per-rental; prefilled from contactTransportPriceCache when empty
  transportPrice      String?
  internalNotes       String?   @db.Text
  driverId            String?
  vehicleId           String?
  // Odległość do klienta (km) — wpisywana ręcznie przez biuro, raz przy danym
  // kliencie (ten sam wzorzec co contactTransportPriceCache). Podstawa
  // wyliczenia kosztu paliwa per wynajem (docs/prompt-claude-code-dashboard-kosztow.md, sekcja 3.1).
  contactDistanceKm   Decimal?  @db.Decimal(6, 1)
  eventType           RentalEventType @default(WYNAJEM)
  // Uwagi kierowcy: dawniej jedno pole na cały wynajem, teraz osobno per etap
  // — RentalFinance.deliveryNotes / pickupNotes (dostawa i odbiór mogą mieć
  // zupełnie inny kontekst, np. "dostawa połączona z innym klientem").
  lastSyncedAt        DateTime?
  deletedInGoogle     Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Klient z bazy panelu (CRM, etap 1). Na razie tylko DODANE obok
  // hubspotContactId i contact*Cache — te pola dalej zasilają przychody,
  // faktury, przypomnienia i alerty; zmienia się jedynie ich źródło w
  // późniejszym kroku. SetNull: usunięcie klienta nigdy nie usuwa wynajmu.
  clientId        String?
  clientContactId String?

  device        Device         @relation(fields: [deviceId], references: [id])
  driver        User?          @relation("RentalDriver", fields: [driverId], references: [id])
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContact ClientContact? @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  reminderRules ReminderRule[]
  messages      Message[]
  finance       RentalFinance?
  lead          Lead?

  @@unique([googleCalendarId, googleEventId])
  @@index([clientId])
  @@index([clientContactId])
  @@map("rentals")
}

model ReminderRule {
  id           String         @id @default(uuid())
  rentalId     String
  daysBefore   Int
  channel      Channel
  messageBody  String         @db.Text
  status       ReminderStatus @default(SCHEDULED)
  scheduledFor DateTime
  sentAt       DateTime?
  errorMessage String?        @db.Text
  edited       Boolean        @default(false)

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("reminder_rules")
}

model Message {
  id                String        @id @default(uuid())
  rentalId          String?
  userId            String?
  channel           Channel
  recipient         String
  subject           String?       @db.Text
  body              String        @db.Text
  status            MessageStatus
  providerMessageId String?
  errorMessage      String?       @db.Text
  sentAt            DateTime      @default(now())

  rental Rental? @relation(fields: [rentalId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  // SMS wysłany z karty klienta / sygnału bez wynajmu (CRM, prompt 2).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("messages")
}

model MessageTemplate {
  id      String  @id @default(uuid())
  key     String  @unique
  label   String
  channel Channel
  subject String? @db.Text
  body    String  @db.Text

  @@map("message_templates")
}

model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

model SyncLog {
  id              String        @id @default(uuid())
  deviceId        String?
  direction       SyncDirection
  eventsProcessed Int
  status          SyncStatus
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())

  device Device? @relation(fields: [deviceId], references: [id])

  @@map("sync_logs")
}

enum ReminderCheckSource {
  CRON
  MANUAL
}

model ReminderCheckLog {
  id             String              @id @default(uuid())
  rentalsChecked Int
  dueCount       Int
  sentCount      Int
  failedCount    Int
  queuedCount    Int                 @default(0)
  source         ReminderCheckSource @default(CRON)
  createdAt      DateTime            @default(now())

  @@map("reminder_check_logs")
}

// --- Moduł finansowy wydarzeń ---
// Reguły biznesowe: docs/finanse-wynajmu/prompt-claude-code-finanse-wynajmu.md
// Cała logika liczenia: src/lib/pricing/ (suma zawsze przeliczana server-side).

model RentalFinance {
  id       String @id @default(cuid())
  rentalId String @unique
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  // --- cena bazowa (wynajem LUB szkolenie) ---
  baseRentalPriceNet         Decimal     @db.Decimal(10, 2)
  baseRentalPriceSource      PriceSource
  baseRentalPriceOverrideNote String?    @db.Text

  // --- wariant głowicy wybrany przy wynajmie (odzwierciedla Device.variantOptions) ---
  deviceVariant String? // np. "single_flex", "double", "dye_vl_ipixel" — null dla *_FLAT i SZKOLENIA

  // --- liczniki impulsów (LightSheer "single_flex" ORAZ Alma Harmony zawsze) ---
  pulseCounterStart      Int?
  pulseCounterEnd        Int?
  pulseCalculationStatus PulseCalculationStatus?

  // --- dopłata za impulsy Alma Harmony (DODATKOWA do baseRentalPriceNet) ---
  // Dla LightSheer flex impulsy określają baseRentalPriceNet bezpośrednio — tu zostaje null.
  pulseSurchargeNet Decimal? @db.Decimal(10, 2)

  // --- nakładka HS (tylko LightSheer wariant "double") ---
  capUsedHS  Boolean?
  capCountHS Int      @default(1) // ile nakładek HS zużyto (gdy capUsedHS); kierowca może zmienić z 1 na 2+
  capFeeNet  Decimal? @db.Decimal(10, 2) // snapshot z PricingSetting w momencie zaznaczenia (za 1 szt.)

  // --- membrany Cooltech (tylko COOLTECH_FLAT) — ten sam wzorzec co nakładka HS ---
  membraneUsed    Boolean?
  membraneCount   Int      @default(1) // ile membran zużyto (gdy membraneUsed); kierowca może zmienić z 1 na 2+
  membraneFeeNet  Decimal? @db.Decimal(10, 2) // snapshot z PricingSetting w momencie zaznaczenia (za 1 szt.)

  // --- VAT ---
  vatApplicable Boolean @default(false)
  vatRate       Decimal @default(23) @db.Decimal(5, 2) // per-wydarzenie, na wypadek zmiany stawki

  // --- suma WYNAJMU — przeliczana i zapisywana po każdej zmianie, NIE ufać wartości z klienta ---
  // Gdy transportPaidSeparately = false, zawiera też transport (jak dawniej).
  totalNet   Decimal @db.Decimal(10, 2)
  totalGross Decimal @db.Decimal(10, 2)

  // --- płatność WYNAJMU ---
  paymentMethod PaymentMethod

  // --- czas pracy kierowcy (minuty) — wpisywany ręcznie przez KIEROWCĘ ---
  // Tylko zbieranie danych pod przyszły moduł kosztów bezpośrednich; nigdzie
  // jeszcze nie raportowane.
  deliveryDurationMinutes Int?
  pickupDurationMinutes   Int?

  // --- pojazd odbioru, gdy inny niż dostawy ---
  // Dostawa zawsze jedzie pojazdem z Rental.vehicleId (ustala biuro). Odbiór
  // domyślnie tym samym — pickupVehicleId = null. Kierowca może zaznaczyć, że
  // odbiór był innym pojazdem (suwak w widoku kierowcy) — wtedy tu ląduje
  // drugi pojazd. Podstawa do liczenia kosztu paliwa PER ETAP (patrz
  // src/lib/costs/calc.ts — każdy etap to osobna trasa tam-i-z-powrotem).
  pickupVehicleId String?
  pickupVehicle   Vehicle? @relation("RentalFinancePickupVehicle", fields: [pickupVehicleId], references: [id])

  // --- uwagi kierowcy PER ETAP (zastępują dawne Rental.driverNotes) ---
  // Dostawa i odbiór mogą mieć zupełnie inny kontekst (np. "dostawa
  // połączona z innym klientem"), więc jedna wspólna uwaga nie wystarczała.
  deliveryNotes String? @db.Text
  pickupNotes   String? @db.Text

  // --- potwierdzenie odbioru — JEDYNY jawny, globalny sygnał "rozliczenie
  // kompletne", niezależny od pojedynczych pól (nakładka/membrana itp., które
  // zapisują się przy KAŻDYM autosave, nie tylko świadomym zakończeniu).
  // Ustawiane jednym, sticky przyciskiem na dole panelu kierowcy — przy
  // płatności gotówką ten sam klik oznacza też "gotówka odebrana" (nie ma już
  // osobnego pola cashCollected: przy PaymentMethod.CASH gotówkę uznajemy za
  // odebraną dokładnie wtedy, gdy confirmedAt != null). Jedyne źródło prawdy
  // dla "brak raportu" (src/lib/report-alerts.ts) i podziału przychodu na
  // rzeczywisty/preliminowany (src/lib/revenue/aggregate.ts).
  confirmedAt DateTime?

  // --- transport ---
  // Kwota netto transportu (dawniej wolny tekst na Rental.transportPrice).
  transportPriceNet       Decimal?       @db.Decimal(10, 2)
  // true = transport rozliczany osobno: własny VAT (zawsze 23%) i własny
  // sposób płatności, poza sumą wynajmu. false = wpada do sumy wynajmu.
  transportPaidSeparately Boolean        @default(false)
  transportVatApplicable  Boolean        @default(false) // tylko gdy transportPaidSeparately
  transportPaymentMethod  PaymentMethod? // tylko gdy transportPaidSeparately
  transportCashCollected  Boolean?       // potwierdzenie odbioru gotówki za transport przez kierowcę
  // Zdenormalizowana suma transportu (tylko gdy transportPaidSeparately).
  transportTotalNet       Decimal?       @db.Decimal(10, 2)
  transportTotalGross     Decimal?       @db.Decimal(10, 2)

  // --- faktura VAT (Fakturownia) — wystawiana ręcznym przyciskiem przez biuro,
  // tylko gdy vatApplicable (niezależnie od sposobu płatności). Wysyłka do
  // KSeF NIE jest tu obsługiwana automatycznie (ma zostać ręczna/na żądanie
  // z dashboardu /finanse/faktury) — patrz src/lib/integrations/fakturownia.ts.
  fakturowniaInvoiceId     Int?
  fakturowniaInvoiceNumber String?
  invoiceIssuedAt          DateTime?
  // Ostatni błąd/status próby wystawienia (np. "nie znaleziono kontrahenta") —
  // czyszczony przy udanym wystawieniu.
  invoiceError             String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rental_finance")
}

// Status "zapłacona" dla DOWOLNEJ faktury z działu w Fakturowni — CELOWO
// niezależny od RentalFinance/Rental. Większość faktur w dziale to faktury
// wystawione ręcznie w Fakturowni, zanim ta integracja powstała (nie mają
// odpowiadającego wynajmu w tej apce), więc śledzenie płatności musi działać
// wyłącznie po ID faktury z Fakturowni, nie przez powiązanie z wynajmem.
// Fakturownia sama nie zna statusu płatności (brak płatnego połączenia z
// bankiem) — ustalamy to sami: ręczny przełącznik albo dopasowanie
// wgranego wyciągu bankowego (dashboard /finanse/faktury).
model FakturowniaPayment {
  fakturowniaInvoiceId Int      @id
  paidAt               DateTime
  updatedAt            DateTime @updatedAt

  @@map("fakturownia_payments")
}

// Historia wgranych wyciągów bankowych (/finanse/faktury) — bez tego wynik
// wgrania znikał po odświeżeniu strony, nie było śladu KIEDY i JAKI plik
// wgrano. Same liczby podsumowania (nie pełna lista dopasowań per wiersz —
// te i tak są odtwarzalne na żądanie z Fakturowni + FakturowniaPayment).
model BankStatementUpload {
  id                 String   @id @default(cuid())
  fileName           String
  uploadedAt         DateTime @default(now())
  uploadedByUserId   String?
  transactionsParsed Int
  autoMatched        Int
  ambiguous          Int
  noMatch            Int

  @@map("bank_statement_uploads")
}

model PriceRule {
  id              String                @id @default(cuid())
  pricingCategory DevicePricingCategory
  variant         String? // null dla kategorii *_FLAT
  durationDays    Int
  priceNet        Decimal               @db.Decimal(10, 2)

  @@unique([pricingCategory, variant, durationDays])
  @@map("price_rules")
}

model PulseTier {
  id                   String                @id @default(cuid())
  pricingCategory      DevicePricingCategory // dziś realnie tylko LIGHTSHEER_VARIANT
  durationDays         Int
  order                Int // kolejność progu w ramach danego durationDays, rosnąco
  maxPulses            Int? // null = ostatni / otwarty próg
  priceNet             Decimal               @db.Decimal(10, 2)
  isOverflowTier       Boolean               @default(false)
  overflowStepPulses   Int? // tylko gdy isOverflowTier
  overflowStepPriceNet Decimal?              @db.Decimal(10, 2) // tylko gdy isOverflowTier

  @@unique([pricingCategory, durationDays, order])
  @@map("pulse_tiers")
}

model PricingSetting {
  id        String   @id @default(cuid())
  key       String   @unique // "cap_fee_hs_net" | "vat_rate_default" | "alma_pulse_rate_net" | "fuel_price_per_liter"
  value     Decimal  @db.Decimal(12, 4)
  // Do wskaźnika "ostatnia aktualizacja: X dni temu" na /ustawienia/pojazdy
  // (fuel_price_per_liter — jeden parametr aktualizowany co tydzień zamiast
  // osobnego kosztu/km per pojazd, patrz Vehicle.fuelConsumptionL100km).
  updatedAt DateTime @default(now()) @updatedAt

  @@map("pricing_settings")
}

// ==================== Moduł kosztów (docs/prompt-claude-code-dashboard-kosztow.md) ====================

model Vehicle {
  id          String   @id @default(cuid())
  name        String // np. "Skoda Fabia"
  plateNumber String
  // Spalanie — stała cecha pojazdu, zmienia się rzadko (w przeciwieństwie do
  // ceny paliwa, która jest teraz JEDNYM współdzielonym parametrem,
  // PricingSetting["fuel_price_per_liter"], nie polem per pojazd — ADMIN
  // aktualizuje cenę paliwa raz, dla całej floty naraz, zamiast osobno
  // przeliczać koszt/km w każdym aucie. koszt/km = spalanie/100 * cena paliwa.
  fuelConsumptionL100km Decimal  @db.Decimal(5, 2)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rentals              Rental[]
  costs                Cost[]
  pickupForRentals     RentalFinance[] @relation("RentalFinancePickupVehicle")
  fuelInvoices         FuelInvoice[]

  @@map("vehicles")
}

enum CostScope {
  GENERAL
  VEHICLE
  DEVICE
}

// Zarządzana tabela (nie luźny string na Cost) — /ustawienia/kategorie-kosztow,
// sekcja 6. Zmiana nazwy aktualizuje się wszędzie od razu (jeden wiersz).
model CostCategory {
  id        String    @id @default(cuid())
  name      String
  scope     CostScope
  // Dezaktywacja, NIE usuwanie — API musi odrzucić twarde usunięcie kategorii
  // z choć jednym powiązanym Cost (sekcja 6). Nieaktywna znika z dropdownu
  // formularza „Dodaj koszt", ale istniejące Cost nadal ją pokazują.
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  costs Cost[]

  @@unique([name, scope])
  @@map("cost_categories")
}

// Pojedynczy wpis kosztowy — ręcznie wpisywany przez ADMINA (z faktury).
// scope/deviceId/vehicleId/categoryId muszą być spójne, walidowane w API
// (sekcja 1.6), nie tylko w UI.
model Cost {
  id          String       @id @default(cuid())
  amount      Decimal      @db.Decimal(10, 2) // netto
  date        DateTime // data poniesienia kosztu (z faktury), nie data wpisania
  scope       CostScope
  categoryId  String
  category    CostCategory @relation(fields: [categoryId], references: [id])
  description String?      @db.Text
  deviceId    String? // tylko gdy scope = DEVICE
  device      Device?      @relation(fields: [deviceId], references: [id])
  vehicleId   String? // tylko gdy scope = VEHICLE
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([scope])
  @@index([date])
  @@index([deviceId])
  @@index([vehicleId])
  @@index([categoryId])
  @@map("costs")
}

enum FuelInvoiceMatchSource {
  AUTO   // rozpoznany automatycznie po nr rej z pola "Nr. Pojazdu" na fakturze
  MANUAL // admin poprawił/wybrał ręcznie w UI
}

// Faktura za paliwo wgrana przez ADMINA (eksport XML z Fakturowni/KSeF) —
// weryfikacja szacowanego kosztu paliwa (Vehicle.fuelConsumptionL100km ×
// odległość × cena/L, patrz src/lib/costs/calc.ts) względem realnych
// wydatków. Karty paliwowe są WSPÓLNE dla całej floty, ale stacja pyta o nr
// rej przy tankowaniu — trafia na fakturę w osobnym polu opisu, stąd
// dopasowanie po numerze rejestracyjnym, nie po koncie/karcie.
// Parser: src/lib/costs/fuel-invoice-parse.ts.
model FuelInvoice {
  id            String    @id @default(cuid())
  fileName      String
  invoiceNumber String?
  invoiceDate   DateTime?
  sellerName    String?
  amountNet     Decimal?  @db.Decimal(10, 2)
  amountGross   Decimal?  @db.Decimal(10, 2)
  currency      String?
  // Pełna treść pliku — do wglądu/debugowania parsera i ponownego
  // dopasowania, gdyby trzeba było poprawić logikę już po wgraniu.
  rawXml        String    @db.LongText
  // Surowa treść pola "Nr. Pojazdu" z faktury (np. "DW9FF41 (PV ...)"),
  // zanim wyciągnięto sam numer — do wglądu, gdy dopasowanie zawiedzie.
  vehiclePlateRaw String?
  vehicleId     String? // null = nie rozpoznano / nie dotyczy jednego pojazdu
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  matchSource   FuelInvoiceMatchSource?
  uploadedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([vehicleId])
  @@index([invoiceDate])
  @@map("fuel_invoices")
}

// ---------------------------------------------------------------------------
// CRM — klienci (etap 1, docs: prompt-claude-code-crm-1-klienci.md)
// ---------------------------------------------------------------------------
// Na razie wyłącznie DODANE: żaden istniejący ekran ani zapytanie ich nie
// czyta. Status klienta (Potencjalny/Nowy/Stały/…) NIE jest tu zapisywany —
// liczony przy odczycie z historii wynajmów (src/lib/clients/status.ts).

// Jedyna ręczna wartość statusu — reszta statusów wynika z wynajmów.
enum ClientStatusOverride {
  NIE_KONTAKTOWAC
}

enum DeviceInterest {
  LIGHTSHEER // Desire / Quattro / Light
  LIGHTSHEER_ET400
  ALMA_HARMONY
  COOLTECH
  RESURFX
  OBSERV
  SZKOLENIE
}

enum ClientSource {
  FORMULARZ_WWW
  TELEFON
  POLECENIE
  GOOGLE_ADS
  META
  POWRACAJACY
  INNE
}

enum ClinicType {
  GABINET_KOSMETOLOGICZNY
  KLINIKA_MEDYCYNY_ESTETYCZNEJ
  SALON_BEAUTY
  KOSMETOLOG_MOBILNY
  INNE
}

// Gabinet / firma. Gdy klientka nie ma firmy, klient jest jednoosobowy, a
// `name` to jej imię i nazwisko.
model Client {
  id                String                @id @default(cuid())
  name              String
  nip               String? // tylko cyfry — normalizowane przy zapisie
  street            String?
  zip               String?
  city              String?
  country           String?               @default("Polska")
  transportPriceNet Decimal?              @db.Decimal(10, 2) // dawne HubSpot „ustalona_cena_transportu”
  distanceKm        Decimal?              @db.Decimal(6, 1) // ostatnia znana odległość (z wynajmów)
  clinicType        ClinicType?
  source            ClientSource?
  deviceInterests   Json? // DeviceInterest[]
  statusOverride    ClientStatusOverride?
  notes             String?               @db.Text
  // Kwalifikacja (prompt 2 v2, 1.0): sygnał to zapytanie, klient to gabinet,
  // z którym faktycznie był kontakt. null = „kontakt z zapytania” (nie na
  // liście klientów). Wynajem / historia z kalendarza / faktura kwalifikują
  // zawsze — liczone przy odczycie (src/lib/clients/qualification.ts).
  qualifiedAt       DateTime?
  qualifiedReason   String? // CALL | EMAIL_REPLY | RENTAL | HISTORY | MANUAL | BACKFILL | HUBSPOT

  // Mapowanie na HubSpot — import, deduplikacja i link „Otwórz w HubSpot” w
  // okresie przejściowym. hubspotSnapshot = wartości pól z ostatniej udanej
  // synchronizacji, podstawa scalania zmian bez cichego nadpisywania.
  hubspotCompanyId String? @unique
  legacyHubspotTag String? // surowa wartość HubSpot „tagi” — tylko do wglądu
  hubspotSnapshot  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts ClientContact[]
  rentals  Rental[]
  history  RentalHistory[]
  aliases  ClientAlias[]
  invoices ClientInvoice[]
  leads    Lead[]
  leadActivities LeadActivity[]
  tasks    Task[]
  messages Message[]
  emails   EmailMessage[]

  @@index([nip])
  @@index([name])
  @@map("clients")
}

model ClientContact {
  id               String  @id @default(cuid())
  clientId         String
  client           Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName        String?
  lastName         String?
  phone            String? // E.164 (+48…), normalizePolishPhone z src/lib/reminders.ts
  // Drugi numer (np. „prywatny” obok „gabinet”) — wyszukiwany na liście,
  // SMS domyślnie na pierwszy. Etykieta z listy albo własna.
  phone2           String?
  phone2Label      String?
  email            String?
  role             String? // np. „właścicielka”, „kosmetolog”
  isPrimary        Boolean @default(false) // dokładnie jedna główna osoba na klienta
  hubspotContactId String? @unique
  hubspotSnapshot  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals Rental[]
  leads   Lead[]

  @@index([clientId])
  @@index([email])
  @@index([phone])
  @@map("client_contacts")
}

// ---------------------------------------------------------------------------
// CRM — historia klienta (docs/crm/prompt-claude-code-crm-3-historia.md).
// Warstwa TYLKO DO ODCZYTU: osobne tabele, nigdy Rental — historia nie może
// uruchomić przypomnień SMS, alertów, zadań kierowcy ani zmienić przychodów.

enum HistoryMatchMethod {
  NIP // faktura: NIP nabywcy = Client.nip
  EMAIL // adres e-mail osoby kontaktowej
  PHONE // numer telefonu w opisie wydarzenia
  NAME_AUTO // dopasowanie nazwy powyżej progu pewności
  MANUAL // potwierdzone / wybrane ręcznie przez biuro
  RENTAL // faktura wystawiona z panelu dla wynajmu (RentalFinance.fakturowniaInvoiceId)
  DOMAIN // e-mail z nieznanego adresu w firmowej domenie klienta — propozycja nowej osoby
}

enum HistoryMatchState {
  AUTO // przypisane automatycznie (wysoka pewność)
  SUGGESTED // propozycja do potwierdzenia
  CONFIRMED // potwierdzone przez człowieka
  IGNORED // nie dotyczy klienta (serwis, blokada terminu, prywatne)
  UNMATCHED // brak propozycji
}

// Wydarzenie z kalendarza urządzenia sprzed okna synchronizacji (device-sync.ts).
model RentalHistory {
  id               String              @id @default(cuid())
  deviceId         String
  device           Device              @relation(fields: [deviceId], references: [id])
  googleCalendarId String
  googleEventId    String
  title            String
  description      String?             @db.Text
  startsAt         DateTime
  endsAt           DateTime
  kind             String // "WYNAJEM" | "SZKOLENIE" | "INNE" — src/lib/history/normalize-title.ts
  // Znormalizowany tytuł — klucz grupowania na /klienci/dopasowania i aliasów.
  titleKey         String              @db.VarChar(191)
  // Kandydaci dla SUGGESTED: [{ clientId, score }] (maks. 3).
  candidates       Json?
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matchMethod      HistoryMatchMethod?
  matchState       HistoryMatchState   @default(UNMATCHED)
  matchScore       Float?
  matchedByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([googleCalendarId, googleEventId])
  @@index([clientId])
  @@index([matchState])
  @@index([titleKey])
  @@map("rental_history")
}

// Nauczone z potwierdzeń: znormalizowany tytuł → klient (prompt 3, 2.3 pkt 4).
model ClientAlias {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  alias           String   @unique @db.VarChar(191)
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([clientId])
  @@map("client_aliases")
}

// Faktury z Fakturowni jako historia klienta (prompt 3B). Kopia metadanych —
// dashboard /finanse/faktury dalej czyta Fakturownię na żywo i tej tabeli
// nie używa.
model ClientInvoice {
  id                   String              @id @default(cuid())
  fakturowniaInvoiceId Int                 @unique
  number               String
  issueDate            DateTime
  sellDate             DateTime // data sprzedaży = data usługi — porównanie z wynajmami (±7 dni)
  buyerName            String
  buyerTaxNo           String? // znormalizowany NIP (same cyfry)
  buyerKey             String              @db.VarChar(191) // znormalizowana nazwa nabywcy — alias / dopasowanie
  totalNet             Decimal             @db.Decimal(10, 2)
  totalGross           Decimal             @db.Decimal(10, 2)
  positionsSummary     String?             @db.Text // nazwy pozycji — do rozpoznania urządzenia
  paymentTo            DateTime? // termin płatności z Fakturowni (payment_to) — status „po terminie”
  paymentType          String? // forma płatności z Fakturowni (transfer / cash / …)
  clientId             String?
  client               Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rentalId             String? // faktura wynajmu z panelu — nie liczona drugi raz
  candidates           Json?
  matchMethod          HistoryMatchMethod?
  matchState           HistoryMatchState   @default(UNMATCHED)
  matchScore           Float?
  matchedByUserId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([clientId])
  @@index([buyerTaxNo])
  @@index([matchState])
  @@map("client_invoices")
}

// ---------------------------------------------------------------------------
// CRM — Sygnały (docs/crm/prompt-claude-code-crm-2-sygnaly.md). Lejek
// sprzedaży: transakcje z HubSpota (formularze WWW przez n8n i ręczne) +
// sygnały dodane w panelu. Po imporcie etap prowadzi panel (ustalone
// 26.09.2026); z HubSpota dochodzą nowe transakcje i notatki.

enum LeadStage {
  SYGNAL // nowy, nikt jeszcze nie rozmawiał
  WYWIAD // rozmowa odbyta, klientka zainteresowana
  OFERTA // oferta wysłana
  REZERWACJA // termin potwierdzony
  WYGRANA // wynajem zrealizowany
  PRZEGRANA // rezygnacja / brak kontaktu — zawsze z powodem
}

enum LeadType {
  POBRANIE_CENNIKA
  KONTAKT
  REZERWACJA_WWW
  SZKOLENIE_WWW
  TELEFON
  EMAIL
  INNE
}

enum LostReason {
  CENA
  TERMIN_ZAJETY
  ODLEGLOSC
  KUPILA_URZADZENIE
  INNE_URZADZENIE
  BRAK_KONTAKTU
  TYLKO_CENNIK
  ARCHIWUM_IMPORTU
  INNE
}

model Lead {
  id              String         @id @default(cuid())
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContactId String?
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  title           String
  type            LeadType
  stage           LeadStage      @default(SYGNAL)
  stageChangedAt  DateTime       @default(now())
  ownerId         String?
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deviceInterest  Json? // DeviceInterest[]
  requestedFrom   DateTime?
  requestedDays   Int?
  location        String?
  message         String?        @db.Text
  // Dane z formularza zapisane przy sygnale — działają także bez klienta.
  contactName     String?
  contactPhone    String? // E.164
  contactEmail    String?
  firstContactAt  DateTime? // pierwsza rozmowa/SMS/notatka — czas reakcji
  nextActionAt    DateTime? // następny krok — napędza „Na dziś”
  lostReason      LostReason?
  lostNote        String?        @db.Text
  returnAt        DateTime?
  rentalId        String?        @unique
  rental          Rental?        @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  // Zaległe zapytanie z 2026 z importu HubSpota — lista „Do obdzwonienia”
  // (prompt 2 v2, 1.0a) zamiast „Na dziś”. Nowe sygnały nigdy tu nie trafiają.
  callList        Boolean        @default(false)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  gclid           String?
  hubspotDealId   String?        @unique
  hubspotSnapshot Json?
  createdAt       DateTime       @default(now()) // przy imporcie = createdate transakcji
  updatedAt       DateTime       @updatedAt

  activities LeadActivity[]
  tasks      Task[]

  @@index([stage])
  @@index([clientId])
  @@index([nextActionAt])
  @@index([callList])
  @@map("leads")
}

enum ActivityType {
  CALL
  CALL_NO_ANSWER
  SMS
  EMAIL
  NOTE
  STAGE_CHANGE
  SYSTEM
}

model LeadActivity {
  id                  String       @id @default(cuid())
  leadId              String?
  lead                Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type                ActivityType
  body                String?      @db.Text
  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  messageId           String?
  hubspotEngagementId String?      @unique
  createdAt           DateTime     @default(now())

  @@index([leadId])
  @@index([clientId])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// CRM — historia e-maili z Gmaila (prompt 3C). TYLKO METADANE i skrót z
// Gmaila: pełna treść nigdy nie trafia do bazy ani logów — karta klienta
// pobiera ją z Gmail API w chwili otwarcia wiadomości.

enum EmailDirection {
  IN // od klienta
  OUT // do klienta
}

model EmailMessage {
  id              String              @id @default(cuid())
  mailbox         String // skrzynka, z której pobrano (np. kontakt@wynajemlasera.pl)
  gmailMessageId  String
  gmailThreadId   String
  rfcMessageId    String?             @db.VarChar(512) // nagłówek Message-ID — deduplikacja między skrzynkami
  direction       EmailDirection
  fromAddress     String
  toAddresses     Json // string[]
  ccAddresses     Json?
  subject         String?             @db.Text
  snippet         String?             @db.Text // skrót z Gmaila (~200 znaków)
  hasAttachments  Boolean             @default(false)
  sentAt          DateTime
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContactId String?
  matchMethod     HistoryMatchMethod?
  createdAt       DateTime            @default(now())

  @@unique([mailbox, gmailMessageId])
  @@index([clientId, sentAt])
  @@index([rfcMessageId])
  @@map("email_messages")
}
