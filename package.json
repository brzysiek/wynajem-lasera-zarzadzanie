    "leaflet": "^1.9.4",
    "mariadb": "^3.4.5",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
